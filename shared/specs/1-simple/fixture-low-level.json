{
  "spec_id": "1-simple",
  "name": "Basic Completion",
  "description": "Single prompt with system message - most basic LLM interaction",
  "inputs": {
    "model": "gpt-5-nano",
    "system": "You are a helpful math assistant. Your anwser only with the final result.",
    "prompt": "What is 69 + 96?"
  },
  "expectations": {
    "spans": {
      "min_count": 1,
      "items": [
        {
          "id": "llm_call",
          "op": {
            "pattern": "gen_ai.*",
            "not": [
              "gen_ai.invoke_agent",
              "gen_ai.create_agent",
              "gen_ai.execute_tool"
            ]
          },
          "required_attributes": {
            "gen_ai.request.model": "gpt-5-nano",
            "gen_ai.response.model": "gpt-5-nano*",
            "gen_ai.usage.input_tokens": true,
            "gen_ai.usage.output_tokens": true,
            "gen_ai.usage.total_tokens": true,
            "gen_ai.response.text": {
              "type": "plain_string"
            },
            "gen_ai.request.messages": {
              "type": "json_array",
              "min_length": 2,
              "items_have": ["role", "content"]
            }
          }
        }
      ]
    },
    "events": {
      "error_count": 0
    }
  }
}
