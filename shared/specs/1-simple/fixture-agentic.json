{
  "spec_id": "1-simple",
  "name": "Basic Completion",
  "description": "Single prompt with system message - most basic LLM interaction",
  "inputs": {
    "model": "gpt-5-nano",
    "system": "You are a helpful math assistant.",
    "prompt": "What is 69 + 96?"
  },
  "expectations": {
    "spans": {
      "min_count": 3,
      "items": [
        {
          "id": "invoke_agent",
          "op": "gen_ai.invoke_agent",
          "required_attributes": {
            "gen_ai.request.model": "gpt-5-nano",
            "gen_ai.request.messages": true
          }
        },
        {
          "id": "generate_text",
          "op": ["gen_ai.chat", "gen_ai.generate_text"],
          "parent": "invoke_agent",
          "required_attributes": {
            "gen_ai.request.model": "gpt-5-nano",
            "gen_ai.usage.input_tokens": true,
            "gen_ai.usage.output_tokens": true,
            "gen_ai.usage.total_tokens": true,
            "gen_ai.request.messages": true
          }
        }
      ]
    },
    "events": {
      "error_count": 0
    }
  }
}
