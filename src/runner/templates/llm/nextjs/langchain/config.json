{
  "name": "langchain",
  "displayName": "LangChain Next.js (Helper Function Instrumentation)",
  "type": "llm-only",
  "platform": "nextjs",
  "streamingMode": "both",
  "dependencies": [
    {
      "package": "@langchain/core",
      "version": "latest"
    },
    {
      "package": "@langchain/openai",
      "version": "latest"
    },
    {
      "package": "@langchain/anthropic",
      "version": "latest"
    },
    {
      "package": "@sentry/nextjs",
      "version": "sentry"
    },
    {
      "package": "next",
      "version": "latest"
    }
  ],
  "versions": ["latest"],
  "sentryVersions": ["latest"],
  "options": {
    "provider": [
      "openai",
      {
        "value": "anthropic",
        "overrides": {
          "modelOverrides": {
            "request": "claude-haiku-4-5",
            "response": "claude-haiku-4-5*"
          }
        }
      }
    ]
  }
}
