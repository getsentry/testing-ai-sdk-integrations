{% extends "base.nextjs.njk" %}

{# Macro to render contents for Google GenAI - handles both string and multimodal array #}
{% macro renderContents(content) %}
{% if content is string %}
[{ text: "{{ content | e }}" }]
{%- elif content is iterable %}
[
{% for part in content %}
{% if part.type == 'text' %}
              { text: "{{ part.text }}" },
{% elif part.type == 'image' %}
              { inlineData: { mimeType: "{{ part.mediaType }}", data: "{{ part.base64 }}" } },
{% endif %}
{% endfor %}
            ]
{%- endif %}
{% endmacro %}

{% block setup %}
// Client will be initialized after dynamic import
let client;
{% endblock %}

{% block dynamic_imports %}
      // Import Google Gen AI from local node_modules
      const { GoogleGenAI } = await import("@google/genai");

      // Get API key from environment
      const GOOGLE_API_KEY = process.env.GOOGLE_GENAI_API_KEY;
      if (!GOOGLE_API_KEY) {
        console.error('ERROR: GOOGLE_GENAI_API_KEY not found in environment');
        throw new Error('GOOGLE_GENAI_API_KEY not provided');
      }

      // Create Google Gen AI client
      const genAI = new GoogleGenAI({
        apiKey: GOOGLE_API_KEY,
      });

      // Wrap client with Sentry instrumentation (recordInputs/recordOutputs default to true when sendDefaultPii: true)
      client = Sentry.instrumentGoogleGenAIClient(genAI);

      console.log('Google Gen AI client initialized and instrumented');
{% endblock %}

{% block test %}
{% for input in inputs %}
{% set system_content = "" %}
{% set non_system_messages = [] %}
{% for message in input.messages %}
{% if message.role == 'system' %}
{% set system_content = message.content %}
{% else %}
{% set _ = non_system_messages.push(message) %}
{% endif %}
{% endfor %}
{% if input.conversationId %}
      if (typeof Sentry.setConversationId === "function") {
        Sentry.setConversationId("{{ input.conversationId }}");
      }
{% endif %}
      // Request {{ loop.index }}{% if loop.length > 1 %} of {{ loop.length }}{% endif %}

      try {
        const contents = [
{% for message in non_system_messages %}
          { role: "{% if message.role == 'assistant' %}model{% else %}{{ message.role }}{% endif %}", parts: {{ renderContents(message.content) }} },
{% endfor %}
        ];

{% if isStreaming %}
        console.log('Starting streaming request {{ loop.index }}...');

        const stream = await client.models.generateContentStream({
          model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
          contents: contents,
{% if system_content %}
          config: { systemInstruction: ["{{ system_content }}"] },
{% endif %}
        });

        const chunks = [];
        for await (const chunk of stream) {
          if (chunk.text) {
            chunks.push(chunk.text);
          }
        }
        console.log('Response {{ loop.index }}:', chunks.join(""));
{% else %}
        console.log('Starting blocking request {{ loop.index }}...');

        const response = await client.models.generateContent({
          model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
          contents: contents,
{% if system_content %}
          config: { systemInstruction: ["{{ system_content }}"] },
{% endif %}
        });
        console.log('Response {{ loop.index }}:', response.text);
{% endif %}
      } catch (error) {
        Sentry.captureException(error);
        console.error('Error in request {{ loop.index }}:', error.message);
      }
{% endfor %}
{% endblock %}
