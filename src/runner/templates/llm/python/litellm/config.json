{
  "name": "litellm",
  "displayName": "LiteLLM Python SDK",
  "type": "llm-only",
  "platform": "python",
  "executionMode": "both",
  "streamingMode": "both",
  "dependencies": [
    {
      "package": "litellm",
      "version": "framework"
    },
    {
      "package": "respx",
      "version": "latest"
    }
  ],
  "versions": ["1.82.6"],
  "sentryVersions": ["latest"],
  "options": {
    "apiStyle": ["completion", "responses"],
    "provider": [
      "openai",
      {
        "value": "anthropic",
        "overrides": {
          "modelOverrides": {
            "request": "claude-haiku-4-5",
            "response": "claude-haiku-4-5*"
          }
        }
      }
    ]
  }
}
