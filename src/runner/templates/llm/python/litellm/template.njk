{% extends "base.python.njk" %}

{# Macro to convert our content format to OpenAI format (LiteLLM uses OpenAI format) #}
{% macro convertMessages(messages) %}
[
{% for message in messages %}
        {
            "role": "{{ message.role }}",
{% if message.content is string %}
            "content": "{{ message.content }}"
{% else %}
            "content": [
{% for part in message.content %}
{% if part.type == 'text' %}
                {"type": "text", "text": "{{ part.text }}"},
{% elif part.type == 'image' %}
                {"type": "image_url", "image_url": {"url": "data:{{ part.mediaType }};base64,{{ part.base64 }}"}},
{% endif %}
{% endfor %}
            ]
{% endif %}
        },
{% endfor %}
    ]
{% endmacro %}

{# Macro to convert non-system messages to Responses API input format #}
{% macro convertResponsesInput(messages) %}
[
{% for message in messages %}
{% if message.role != "system" %}
        {
            "role": "{{ message.role }}",
{% if message.content is string %}
            "content": "{{ message.content }}"
{% else %}
            "content": [
{% for part in message.content %}
{% if part.type == 'text' %}
                {"type": "input_text", "text": "{{ part.text }}"},
{% elif part.type == 'image' %}
                {"type": "input_image", "image_url": "data:{{ part.mediaType }};base64,{{ part.base64 }}"},
{% endif %}
{% endfor %}
            ]
{% endif %}
        },
{% endif %}
{% endfor %}
    ]
{% endmacro %}

{# Macro to extract system message content for instructions parameter #}
{% macro extractInstructions(messages) %}
{% for message in messages %}{% if message.role == "system" %}{{ message.content }}{% endif %}{% endfor %}
{% endmacro %}

{% block imports %}
{{ super() }}
{% if not isAsync %}
import time
{% endif %}

import litellm
from sentry_sdk.integrations.litellm import LiteLLMIntegration
from sentry_sdk.integrations.openai import OpenAIIntegration
{% if causeAPIError %}
import respx
import httpx
{% endif %}
{% endblock %}

{% block inject_api_error %}
{% if causeAPIError %}
{% if provider == "anthropic" %}
respx.route(host="openrouter.ai").mock(return_value=httpx.Response(500, json={"error": {"message": "Server error", "type": "server_error"}}))
{% else %}
respx.route(host="api.openai.com").mock(return_value=httpx.Response(500, json={"error": {"message": "Server error", "type": "server_error"}}))
{% endif %}
respx.mock.start()
{% endif %}
{% endblock %}

{% block sdk_setup %}
sentry_sdk.init(
    dsn=os.environ.get("SENTRY_DSN"),
    traces_sample_rate=1.0,
    send_default_pii=True,
    stream_gen_ai_spans={{ "True" if streamGenAiSpans else "False" }},
    integrations=[LiteLLMIntegration(include_prompts=True)],
    disabled_integrations=[OpenAIIntegration()],
)
{% endblock %}

{% block test %}
{% for input in inputs %}
    # Turn {{ loop.index }}
{% if input.conversationId %}
    sentry_sdk.ai.set_conversation_id("{{ input.conversationId }}")
{% endif %}
{% if apiStyle == "responses" %}
{% if isStreaming %}
{% if isAsync %}
    stream = await litellm.aresponses(
{% else %}
    stream = litellm.responses(
{% endif %}
        model="{% if provider == "anthropic" %}openrouter/anthropic{% else %}openai{% endif %}/{{ input.model }}",
{% set instructions = extractInstructions(input.messages) | trim %}
{% if instructions %}
        instructions="{{ instructions }}",
{% endif %}
        input={{ convertResponsesInput(input.messages) }},
        stream=True,
    )

    collected_content = []
{% if isAsync %}
    async for event in stream:
{% else %}
    for event in stream:
{% endif %}
        if hasattr(event, "type") and event.type == "response.output_text.delta":
            collected_content.append(event.delta)

    full_response = "".join(collected_content)
    print(f"Turn {{ loop.index }} Response: {full_response}")
{% else %}
{% if isAsync %}
    response = await litellm.aresponses(
{% else %}
    response = litellm.responses(
{% endif %}
        model="{% if provider == "anthropic" %}openrouter/anthropic{% else %}openai{% endif %}/{{ input.model }}",
{% set instructions = extractInstructions(input.messages) | trim %}
{% if instructions %}
        instructions="{{ instructions }}",
{% endif %}
        input={{ convertResponsesInput(input.messages) }},
    )
    print(f"Turn {{ loop.index }} Response: {response.output_text}")
{% endif %}
{% else %}
{% if isStreaming %}
{% if isAsync %}
    stream = await litellm.acompletion(
{% else %}
    stream = litellm.completion(
{% endif %}
        model="{% if provider == "anthropic" %}openrouter/anthropic{% else %}openai{% endif %}/{{ input.model }}",
        messages={{ convertMessages(input.messages) }},
        stream=True,
    )
    
    collected_content = []
{% if isAsync %}
    async for chunk in stream:
{% else %}
    for chunk in stream:
{% endif %}
        if chunk.choices[0].delta.content is not None:
            collected_content.append(chunk.choices[0].delta.content)
    
    full_response = "".join(collected_content)
    print(f"Turn {{ loop.index }} Response: {full_response}")
{% else %}
{% if isAsync %}
    response = await litellm.acompletion(
{% else %}
    response = litellm.completion(
{% endif %}
        model="{% if provider == "anthropic" %}openrouter/anthropic{% else %}openai{% endif %}/{{ input.model }}",
        messages={{ convertMessages(input.messages) }},
    )
    print(f"Turn {{ loop.index }} Response: {response.choices[0].message.content}")
{% endif %}
{% endif %}
{% if isAsync %}
    await asyncio.sleep(0.1)  # sleep is necessary for LiteLLM because it needs threaded callbacks to finish
{% else %}
    time.sleep(0.1)  # sleep is necessary for LiteLLM because it needs threaded callbacks to finish
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
{% endblock %}
