{% extends "base.py.njk" %}

{% block imports %}
{{ super() }}
from cohere import ClientV2
{% if causeAPIError %}
import respx
import httpx
{% endif %}
{% endblock %}

{% block inject_api_error %}
{% if causeAPIError %}
respx.route(host="api.cohere.com").mock(return_value=httpx.Response(500, json={"message": "Server error"}))
respx.mock.start()
{% endif %}
{% endblock %}

{% block setup %}
client = ClientV2()
{% endblock %}

{% block test %}
{% for input in inputs %}
    # Turn {{ loop.index }}
    messages = [
{% for message in input.messages %}
        {"role": "{{ message.role }}", "content": "{{ message.content }}"},
{% endfor %}
    ]

{% if isStreaming %}
    stream = client.chat_stream(
        model="{{ input.model }}",
        messages=messages,
    )
    collected_content = []
    for event in stream:
        if event.type == "content-delta":
            collected_content.append(event.delta.message.content.text)
    full_response = "".join(collected_content)
    print(f"Turn {{ loop.index }} Response: {full_response}")
{% else %}
    response = client.chat(
        model="{{ input.model }}",
        messages=messages,
    )
    text = response.message.content[0].text if response.message.content else ""
    print(f"Turn {{ loop.index }} Response: {text}")
{% endif %}
{% if not loop.last %}

{% endif %}
{% endfor %}
{% endblock %}
