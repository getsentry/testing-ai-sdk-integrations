{% extends "base.js.njk" %}

{% block imports %}
{{ super() }}
// GoogleGenAI is imported dynamically after Sentry.init() to ensure instrumentation hooks are in place
{% endblock %}

{% block setup %}
// Client will be initialized after dynamic import
let client;
{% endblock %}

{% block test %}
// Dynamic import of @google/genai AFTER Sentry.init() to ensure instrumentation
const { GoogleGenAI } = await import('@google/genai');

// Initialize Google GenAI client with Vertex AI
client = new GoogleGenAI({
  vertexai: true,
  project: process.env.GOOGLE_VERTEX_PROJECT,
  location: process.env.GOOGLE_VERTEX_LOCATION,
});

{% for input in inputs %}
  // Turn {{ loop.index }}: Generate content
  {# Extract system and user messages #}
  {% set system_content = "" %}
  {% set user_content = "" %}
  {% for message in input.messages %}
    {% if message.role == 'system' %}
      {% set system_content = message.content %}
    {% elif message.role == 'user' %}
      {% set user_content = message.content %}
    {% endif %}
  {% endfor %}

  const response{{ loop.index }} = await client.models.generateContent({
    model: '{{ input.model }}',
    contents: '{{ user_content }}',
{% if system_content %}
    config: {
      systemInstruction: ['{{ system_content }}'],
    },
{% endif %}
  });

  // Print response
  console.log(`Turn {{ loop.index }} Response: ${response{{ loop.index }}.text}`);
{% if not loop.last %}
  console.log();  // Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
