{% extends "base.js.njk" %}

{% block imports %}
{{ super() }}
// LangChain is imported dynamically after Sentry.init() to ensure instrumentation hooks are in place
{% endblock %}

{% block setup %}
// Chat client will be initialized after dynamic import
let chat;
{% endblock %}

{% block test %}
// Dynamic imports AFTER Sentry.init() to ensure instrumentation
const { ChatOpenAI } = await import('@langchain/openai');
const { HumanMessage, SystemMessage, AIMessage } = await import('@langchain/core/messages');

// Initialize LangChain ChatOpenAI
chat = new ChatOpenAI({
  modelName: '{{ inputs[0].model }}',
  apiKey: process.env.OPENAI_API_KEY,
});

{% for input in inputs %}
  // Turn {{ loop.index }}: Build messages
  const messages{{ loop.index }} = [
{% for message in input.messages %}
  {% if message.role == 'system' %}
    new SystemMessage('{{ message.content }}'),
  {% elif message.role == 'user' %}
    new HumanMessage('{{ message.content }}'),
  {% elif message.role == 'assistant' %}
    new AIMessage('{{ message.content }}'),
  {% endif %}
{% endfor %}
  ];

  const response{{ loop.index }} = await chat.invoke(messages{{ loop.index }});

  // Print response
  console.log(`Turn {{ loop.index }} Response: ${response{{ loop.index }}.content}`);
{% if not loop.last %}
  console.log();  // Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
