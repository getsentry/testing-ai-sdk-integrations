{% extends "base.js.njk" %}

{% block imports %}
{{ super() }}
const OpenAI = require('openai');
{% endblock %}

{% block setup %}
// Initialize OpenAI client
const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});
{% endblock %}

{% block test %}
{% for input in inputs %}
  // Turn {{ loop.index }}: Create chat completion
  const response{{ loop.index }} = await client.chat.completions.create({
    model: '{{ input.model }}',
    messages: [
{% for message in input.messages %}
      { role: '{{ message.role }}', content: '{{ message.content }}' },
{% endfor %}
    ],
  });

  // Print response
  console.log(`Turn {{ loop.index }} Response: ${response{{ loop.index }}.choices[0].message.content}`);
  console.log(`Model: ${response{{ loop.index }}.model}`);
  console.log(`Tokens - Prompt: ${response{{ loop.index }}.usage.prompt_tokens}, Completion: ${response{{ loop.index }}.usage.completion_tokens}, Total: ${response{{ loop.index }}.usage.total_tokens}`);
{% if not loop.last %}
  console.log();  // Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
