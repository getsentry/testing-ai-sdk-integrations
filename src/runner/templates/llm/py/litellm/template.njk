{% extends "base.py.njk" %}

{% block imports %}
{{ super() }}
from time import sleep
import litellm
from sentry_sdk.integrations.litellm import LiteLLMIntegration
from sentry_sdk.integrations.openai import OpenAIIntegration
{% endblock %}

{% block sdk_setup %}
sentry_sdk.init(
    dsn=os.environ.get("SENTRY_DSN"),
    traces_sample_rate=1.0,  # Capture 100% of transactions for testing
    send_default_pii=True,
    integrations=[LiteLLMIntegration(include_prompts=True)],
    disabled_integrations=[OpenAIIntegration()],
)
{% endblock %}

{% block setup %}
# LiteLLM uses environment variables for API keys (OPENAI_API_KEY, etc.)
{% endblock %}

{% block test %}
{% for input in inputs %}
    # Turn {{ loop.index }}: Create completion via LiteLLM
{% if isAsync %}
    response = await litellm.acompletion(
{% else %}
    response = litellm.completion(
{% endif %}
        model="openai/{{ input.model }}",  # LiteLLM requires provider prefix
        messages=[
{% for message in input.messages %}
            {"role": "{{ message.role }}", "content": "{{ message.content }}"},
{% endfor %}
        ]
    )

    # Print response
    print(f"Turn {{ loop.index }} Response: {response.choices[0].message.content}")
    print(f"Model: {response.model}")
    print(f"Tokens - Prompt: {response.usage.prompt_tokens}, Completion: {response.usage.completion_tokens}, Total: {response.usage.total_tokens}")
{% if not loop.last %}
    print()  # Blank line between turns
{% endif %}
{% endfor %}
    sleep(1)
{% endblock %}
