{% extends "base.py.njk" %}

{% block imports %}
{{ super() }}
from google import genai
{% endblock %}

{% block setup %}
# Initialize Google GenAI client
client = genai.Client(api_key=os.environ.get("GOOGLE_GENAI_API_KEY"))
{% endblock %}

{% block test %}
{% for input in inputs %}
    # Turn {{ loop.index }}: Generate content
    {# Extract system message if present #}
    {% set system_content = "" %}
    {% set user_content = "" %}
    {% for message in input.messages %}
        {% if message.role == 'system' %}
            {% set system_content = message.content %}
        {% elif message.role == 'user' %}
            {% set user_content = message.content %}
        {% endif %}
    {% endfor %}

{% if isAsync %}
    response = await client.aio.models.generate_content(
{% else %}
    response = client.models.generate_content(
{% endif %}
        model="{{ input.model }}",
        contents="{{ user_content }}",
{% if system_content %}
        config=genai.types.GenerateContentConfig(
            system_instruction="{{ system_content }}",
        ),
{% endif %}
    )

    # Print response
    print(f"Turn {{ loop.index }} Response: {response.text}")
{% if not loop.last %}
    print()  # Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
