{% extends "base.py.njk" %}

{% block imports %}
{{ super() }}
import os
{% if isAsync %}
from openai import AsyncOpenAI
{% else %}
from openai import OpenAI
{% endif %}
{% endblock %}

{% block setup %}
# Initialize OpenAI client
{% if isAsync %}
client = AsyncOpenAI(api_key=os.environ.get("OPENAI_API_KEY"))
{% else %}
client = OpenAI(api_key=os.environ.get("OPENAI_API_KEY"))
{% endif %}
{% endblock %}

{% block test %}
{% for input in inputs %}
    # Turn {{ loop.index }}: Create chat completion
{% if isAsync %}
    response = await client.chat.completions.create(
{% else %}
    response = client.chat.completions.create(
{% endif %}
        model="{{ input.model }}",
        messages=[
{% for message in input.messages %}
            {"role": "{{ message.role }}", "content": "{{ message.content }}"},
{% endfor %}
        ]
    )

    # Print response
    print(f"Turn {{ loop.index }} Response: {response.choices[0].message.content}")
    print(f"Model: {response.model}")
    print(f"Tokens - Prompt: {response.usage.prompt_tokens}, Completion: {response.usage.completion_tokens}, Total: {response.usage.total_tokens}")
{% if not loop.last %}
    print()  # Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
