{% extends "base.node.njk" %}

{# Macro to render message content for Chat Completions API #}
{% macro renderChatContent(content) %}
{% if content is string %}
"{{ content }}"
{%- elif content is iterable %}
[
{% for part in content %}
{% if part.type == 'text' %}
              { type: "text", text: "{{ part.text }}" },
{% elif part.type == 'image' %}
              { type: "image_url", image_url: { url: "data:{{ part.mediaType }};base64,{{ part.base64 }}" } },
{% endif %}
{% endfor %}
            ]
{%- endif %}
{% endmacro %}

{# Macro to render message content for Responses API #}
{% macro renderResponsesContent(content) %}
{% if content is string %}
"{{ content }}"
{%- elif content is iterable %}
[
{% for part in content %}
{% if part.type == 'text' %}
              { type: "input_text", text: "{{ part.text }}" },
{% elif part.type == 'image' %}
              { type: "input_image", image_url: "data:{{ part.mediaType }};base64,{{ part.base64 }}" },
{% endif %}
{% endfor %}
            ]
{%- endif %}
{% endmacro %}

{% block dynamic_imports %}
const { default: OpenAI } = await import("openai");
const client = new OpenAI();
{% endblock %}

{% block test %}
{% for input in inputs %}
{% if input.conversationId %}
      if (typeof Sentry.setConversationId === "function") {
        Sentry.setConversationId("{{ input.conversationId }}");
      }
{% endif %}
      // Request {{ loop.index }}{% if loop.length > 1 %} of {{ loop.length }}{% endif %}

      try {
{% if apiStyle == "responses" %}
{% if isStreaming %}
        const stream = await client.responses.create({
          model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
{% for message in input.messages %}{% if message.role == "system" %}
          instructions: {{ renderResponsesContent(message.content) }},
{% endif %}{% endfor %}
          input: [
{% for message in input.messages %}{% if message.role != "system" %}
            { role: "{{ message.role }}", content: {{ renderResponsesContent(message.content) }} },
{% endif %}{% endfor %}
          ],
          stream: true,
        });

        const chunks = [];
        for await (const event of stream) {
          if (event.type === "response.output_text.delta") {
            chunks.push(event.delta);
          }
        }
        console.log("Response:", chunks.join(""));
{% else %}
        const response = await client.responses.create({
          model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
{% for message in input.messages %}{% if message.role == "system" %}
          instructions: {{ renderResponsesContent(message.content) }},
{% endif %}{% endfor %}
          input: [
{% for message in input.messages %}{% if message.role != "system" %}
            { role: "{{ message.role }}", content: {{ renderResponsesContent(message.content) }} },
{% endif %}{% endfor %}
          ],
        });
        console.log("Response:", response.output_text);
{% endif %}
{% else %}
{% if isStreaming %}
        const stream = await client.chat.completions.create({
          model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
          messages: [
{% for message in input.messages %}
            { role: "{{ message.role }}", content: {{ renderChatContent(message.content) }} },
{% endfor %}
          ],
          stream: true,
          stream_options: { include_usage: true },
        });

        const chunks = [];
        for await (const chunk of stream) {
          const content = chunk.choices[0]?.delta?.content;
          if (content) {
            chunks.push(content);
          }
        }
        console.log("Response:", chunks.join(""));
{% else %}
        const response = await client.chat.completions.create({
          model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
          messages: [
{% for message in input.messages %}
            { role: "{{ message.role }}", content: {{ renderChatContent(message.content) }} },
{% endfor %}
          ],
        });
        console.log("Response:", response.choices[0].message.content);
{% endif %}
{% endif %}
      } catch (error) {
        Sentry.captureException(error);
        console.error("Error:", error.message);
      }
{% endfor %}
{% endblock %}
