{% extends "base.browser.njk" %}

{# Macro to render parts array for Google GenAI - returns a [...] array #}
{% macro renderParts(content) %}
{% if content is string %}
[{ text: "{{ content }}" }]
{%- elif content is iterable %}
[
{% for part in content %}
{% if part.type == 'text' %}
              { text: "{{ part.text }}" },
{% elif part.type == 'image' %}
              { inlineData: { mimeType: "{{ part.mediaType }}", data: "{{ part.base64 }}" } },
{% endif %}
{% endfor %}
            ]
{%- endif %}
{% endmacro %}

{% block dynamic_imports %}
    const { GoogleGenAI } = await import("@google/genai");

    const GOOGLE_API_KEY = window.GOOGLE_GENAI_API_KEY;
    if (!GOOGLE_API_KEY) {
      log('ERROR: GOOGLE_GENAI_API_KEY not found in window');
      throw new Error('GOOGLE_GENAI_API_KEY not provided');
    }

    // WARNING: API key is exposed in browser - this is for testing only!
    const genAI = new GoogleGenAI({
      apiKey: GOOGLE_API_KEY,
    });

    const client = Sentry.instrumentGoogleGenAIClient(genAI);
    log('Google Gen AI client initialized and instrumented');
{% endblock %}

{% block test %}
{% for input in inputs %}
{% if input.conversationId %}
          if (typeof Sentry.setConversationId === "function") {
            Sentry.setConversationId("{{ input.conversationId }}");
          }
{% endif %}
          // Request {{ loop.index }}{% if loop.length > 1 %} of {{ loop.length }}{% endif %}

          try {
{% set system_content = "" %}
{% set non_system_messages = [] %}
{% for message in input.messages %}
{% if message.role == 'system' %}
{% set system_content = message.content %}
{% else %}
{% set _ = non_system_messages.push(message) %}
{% endif %}
{% endfor %}

            const contents = [
{% for message in non_system_messages %}
              { role: "{% if message.role == 'assistant' %}model{% else %}{{ message.role }}{% endif %}", parts: {{ renderParts(message.content) }} },
{% endfor %}
            ];

{% if isStreaming %}
            log('Starting streaming request {{ loop.index }}...');

            const stream = await client.models.generateContentStream({
              model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
              contents: contents,
{% if system_content %}
              config: { systemInstruction: ["{{ system_content }}"] },
{% endif %}
            });

            const chunks = [];
            for await (const chunk of stream) {
              if (chunk.text) {
                chunks.push(chunk.text);
              }
            }
            log('Response {{ loop.index }}:', chunks.join(""));
{% else %}
            log('Starting blocking request {{ loop.index }}...');

            const response = await client.models.generateContent({
              model: {% if causeAPIError %}"invalid-model"{% else %}"{{ input.model }}"{% endif %},
              contents: contents,
{% if system_content %}
              config: { systemInstruction: ["{{ system_content }}"] },
{% endif %}
            });
            log('Response {{ loop.index }}:', response.text);
{% endif %}
          } catch (error) {
            Sentry.captureException(error);
            log('Error in request {{ loop.index }}:', error.message);
            console.error("Error:", error);
          }
{% endfor %}
{% endblock %}
