{% extends "base.browser.njk" %}

{# Macro to render message content for LangChain - handles both string and multimodal array #}
{% macro renderLangChainContent(content) %}
{% if content is string %}
"{{ content }}"
{%- elif content is iterable %}
[
{% for part in content %}
{% if part.type == 'text' %}
              { type: "text", text: "{{ part.text }}" },
{% elif part.type == 'image' %}
              { type: "image_url", image_url: { url: "data:{{ part.mediaType }};base64,{{ part.base64 }}" } },
{% endif %}
{% endfor %}
            ]
{%- endif %}
{% endmacro %}

{% block dynamic_imports %}
{% if provider == "anthropic" %}
    const { ChatAnthropic } = await import("@langchain/anthropic");
{% else %}
    const { ChatOpenAI } = await import("@langchain/openai");
{% endif %}
    const { HumanMessage, SystemMessage, AIMessage } = await import("@langchain/core/messages");

{% if provider == "anthropic" %}
    const ANTHROPIC_API_KEY = window.ANTHROPIC_API_KEY;
    if (!ANTHROPIC_API_KEY) {
      log('ERROR: ANTHROPIC_API_KEY not found in window');
      throw new Error('ANTHROPIC_API_KEY not provided');
    }
{% else %}
    const OPENAI_API_KEY = window.OPENAI_API_KEY;
    if (!OPENAI_API_KEY) {
      log('ERROR: OPENAI_API_KEY not found in window');
      throw new Error('OPENAI_API_KEY not provided');
    }
{% endif %}

    const callbackHandler = Sentry.createLangChainCallbackHandler();

    // API key exposed in browser - for testing only!
{% if provider == "anthropic" %}
    const chat = new ChatAnthropic({
      modelName: {% if causeAPIError %}"invalid-model"{% else %}"{{ inputs[0].model }}"{% endif %},
      anthropicApiKey: ANTHROPIC_API_KEY,
    });

    log('LangChain ChatAnthropic initialized with createLangChainCallbackHandler');
{% else %}
    const chat = new ChatOpenAI({
      modelName: {% if causeAPIError %}"invalid-model"{% else %}"{{ inputs[0].model }}"{% endif %},
      openAIApiKey: OPENAI_API_KEY,
    });

    log('LangChain ChatOpenAI initialized with createLangChainCallbackHandler');
{% endif %}
{% endblock %}

{% block test %}
{% for input in inputs %}
{% if input.conversationId %}
          if (typeof Sentry.setConversationId === "function") {
            Sentry.setConversationId("{{ input.conversationId }}");
          }
{% endif %}
          // Request {{ loop.index }}{% if loop.length > 1 %} of {{ loop.length }}{% endif %}

          const messages{{ loop.index }} = [
{% for message in input.messages %}
{% if message.role == 'system' %}
            new SystemMessage("{{ message.content }}"),
{% elif message.role == 'user' %}
            new HumanMessage({ content: {{ renderLangChainContent(message.content) }} }),
{% elif message.role == 'assistant' %}
            new AIMessage("{{ message.content }}"),
{% endif %}
{% endfor %}
          ];

          try {
{% if isStreaming %}
            log('Starting streaming request {{ loop.index }}...');

            const stream = await chat.stream(messages{{ loop.index }}, {
              callbacks: [callbackHandler],
            });
            const chunks = [];
            for await (const chunk of stream) {
              if (chunk.content) {
                chunks.push(chunk.content);
              }
            }
            log('Response {{ loop.index }}:', chunks.join(""));
{% else %}
            log('Starting blocking request {{ loop.index }}...');

            const response = await chat.invoke(messages{{ loop.index }}, {
              callbacks: [callbackHandler],
            });
            log('Response {{ loop.index }}:', response.content);
{% endif %}
          } catch (error) {
            Sentry.captureException(error);
            log('Error in request {{ loop.index }}:', error.message);
            console.error("Error:", error);
          }
{% endfor %}
{% endblock %}
