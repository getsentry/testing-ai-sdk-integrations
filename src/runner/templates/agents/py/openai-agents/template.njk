{% extends "base.py.njk" %}

{% block imports %}
{{ super() }}
from agents import function_tool, Agent, Runner
{% endblock %}

{% block setup %}
# Define tool functions using @function_tool decorator
{% for tool in agent.tools %}
@function_tool
def {{ tool.name }}({% for param in tool.parameters.required %}{{ param }}: str{% if not loop.last %}, {% endif %}{% endfor %}):
    """{{ tool.description }}"""
    {% if tool.result is defined %}
    return {{ tool.result | tojson }}
    {% elif tool.error is defined %}
    raise Exception("{{ tool.error }}")
    {% else %}
    return None
    {% endif %}

{% endfor %}
# Create agent with tools
agent = Agent(
    name="{{ agent.name }}",
    instructions="{{ agent.description }}",
    tools=[{% for tool in agent.tools %}{{ tool.name }}{% if not loop.last %}, {% endif %}{% endfor %}],
    model="{{ inputs[0].model }}",
)
{% endblock %}

{% block test %}
{% for input in inputs %}
    # Turn {{ loop.index }}: Build prompt from messages
    prompt = ""
{% for message in input.messages %}
    prompt += "{{ message.content }}\n"
{% endfor %}
    prompt = prompt.strip()
    
    # Run agent
    result = Runner.run_streamed(agent, input=prompt)
    
    # Print result
    print(f"Turn {{ loop.index }} Agent result: {result}")
{% if not loop.last %}
    print()  # Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
