{
  "name": "vercel",
  "displayName": "Vercel AI SDK (Next.js)",
  "type": "agentic",
  "platform": "nextjs",
  "streamingMode": "both",
  "dependencies": [
    {
      "package": "ai",
      "version": "framework"
    },
    {
      "package": "@ai-sdk/openai",
      "version": "latest"
    },
    {
      "package": "@ai-sdk/anthropic",
      "version": "latest"
    },
    {
      "package": "@sentry/nextjs",
      "version": "sentry"
    },
    {
      "package": "next",
      "version": "latest"
    }
  ],
  "versions": ["6.0.116"],
  "sentryVersions": ["latest"],
  "options": {
    "agentStyle": ["function", "class"],
    "provider": [
      "openai",
      {
        "value": "anthropic",
        "overrides": {
          "modelOverrides": {
            "request": "claude-haiku-4-5",
            "response": "claude-haiku-4-5*"
          }
        }
      }
    ]
  }
}
