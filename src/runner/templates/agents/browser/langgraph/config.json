{
  "name": "langgraph",
  "displayName": "LangGraph Browser",
  "type": "agentic",
  "platform": "browser",
  "dependencies": [
    { "package": "@sentry/browser", "version": "sentry" },
    { "package": "@langchain/langgraph", "version": "framework" },
    { "package": "@langchain/openai", "version": "1.2.12" },
    { "package": "@langchain/anthropic", "version": "latest" },
    { "package": "@langchain/core", "version": "1.1.30" },
    { "package": "zod", "version": "3" }
  ],
  "versions": ["1.2.0"],
  "sentryVersions": ["latest"],
  "streamingMode": "both",
  "options": {
    "variant": ["graph", "langchain", "combined", "compiled", "custom-state"],
    "provider": [
      "openai",
      {
        "value": "anthropic",
        "overrides": {
          "modelOverrides": {
            "request": "claude-haiku-4-5",
            "response": "claude-haiku-4-5*"
          }
        }
      }
    ]
  }
}
