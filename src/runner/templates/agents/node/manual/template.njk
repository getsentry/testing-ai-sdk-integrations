{% extends "base.node.njk" %}

{% block setup %}
function estimateTokens(text) {
  return Math.max(1, Math.floor(String(text).length / 4));
}

function messagesContentLength(messages) {
  let total = 0;
  for (const m of messages) {
    const c = m.content;
    if (typeof c === "string") {
      total += c.length;
    } else if (Array.isArray(c)) {
      for (const part of c) {
        if (part.text) total += part.text.length;
      }
    }
  }
  return total;
}

function trimMessages(messages, maxSize = 10000) {
  const fullJson = JSON.stringify(messages);
  const originalLength = fullJson.length;
  if (originalLength <= maxSize) {
    return { messages, originalLength, trimmed: false };
  }
  const trimmed = messages.map((msg) => {
    const copy = { ...msg };
    if (typeof copy.content === "string" && copy.content.length > 200) {
      copy.content = copy.content.slice(0, 200) + "... [trimmed]";
    }
    if (Array.isArray(copy.parts)) {
      copy.parts = copy.parts.map((p) => {
        if (typeof p.text === "string" && p.text.length > 200) {
          return { ...p, text: p.text.slice(0, 200) + "... [trimmed]" };
        }
        return p;
      });
    }
    return copy;
  });
  return { messages: trimmed, originalLength, trimmed: true };
}

function buildSentryMessages(messages) {
  const sentryMessages = [];
  const legacyMessages = [];
  let systemInstructions = null;

  for (const msg of messages) {
    const { role, content } = msg;

    if (role === "system") {
      systemInstructions = typeof content === "string" ? content : JSON.stringify(content);
    }

    const parts = [];
    if (typeof content === "string") {
      parts.push({ type: "text", text: content });
    } else if (Array.isArray(content)) {
      for (const part of content) {
        if (part.type === "text") {
          parts.push({ type: "text", text: part.text });
        } else if (part.type === "image") {
          parts.push({ type: "text", text: "[Blob substitute]" });
        }
      }
    }

    sentryMessages.push({
      role,
      content: typeof content === "string" ? content : "[multimodal]",
      parts,
    });

    if (Array.isArray(content)) {
      const redacted = content.map((part) =>
        part.type === "image" ? { type: "text", text: "[Blob substitute]" } : part
      );
      legacyMessages.push({ role, content: redacted });
    } else {
      legacyMessages.push({ role, content });
    }
  }

  return { sentryMessages, legacyMessages, systemInstructions };
}

const AGENT_NAME = "{{ agent.name }}";
const TOOLS = {{ agent.tools | dump }};
{% endblock %}

{% block test %}
{% for input in inputs %}
{% if input.conversationId %}
      if (typeof Sentry.setConversationId === "function") {
        Sentry.setConversationId("{{ input.conversationId }}");
      }
{% endif %}
      // ── Turn {{ loop.index }} ──
      const model{{ loop.index }} = "{{ input.model }}";
      const messages{{ loop.index }} = {{ input.messages | dump }};

      const { sentryMessages: sentry{{ loop.index }}, systemInstructions: system{{ loop.index }} } =
        buildSentryMessages(messages{{ loop.index }});

      const otel{{ loop.index }} = trimMessages(sentry{{ loop.index }});
      const otelJson{{ loop.index }} = JSON.stringify(otel{{ loop.index }}.messages);

      const contentLen{{ loop.index }} = messagesContentLength(messages{{ loop.index }});
      const inputTokens{{ loop.index }} = estimateTokens(contentLen{{ loop.index }}) + 10;
      const outputTokens{{ loop.index }} = 20;
      const totalTokens{{ loop.index }} = inputTokens{{ loop.index }} + outputTokens{{ loop.index }};
      const responseText{{ loop.index }} = "This is a simulated agent response for turn {{ loop.index }}.";

      // Build tool definitions and output tool call parts
      const toolDefinitions{{ loop.index }} = [];
      const outputToolCallParts{{ loop.index }} = [];
      for (const tool of TOOLS) {
        toolDefinitions{{ loop.index }}.push({
          name: tool.name,
          description: tool.description,
          parameters: tool.parameters || {},
        });
        if (tool.result !== undefined || tool.error !== undefined) {
          const toolArgs = tool.arguments || {};
          outputToolCallParts{{ loop.index }}.push({
            type: "tool_call",
            name: tool.name,
            arguments: JSON.stringify(toolArgs),
          });
        }
      }
      const toolDefinitionsJson{{ loop.index }} = JSON.stringify(toolDefinitions{{ loop.index }});

      const outputParts{{ loop.index }} = [{ type: "text", text: responseText{{ loop.index }} }, ...outputToolCallParts{{ loop.index }}];
      const outputMessages{{ loop.index }} = JSON.stringify([{ role: "assistant", parts: outputParts{{ loop.index }} }]);

      // Agent span (parent)
      const agentDesc{{ loop.index }} = `invoke_agent ${AGENT_NAME}`;
      await Sentry.startSpan({ op: "gen_ai.invoke_agent", name: agentDesc{{ loop.index }} }, async (agentSpan) => {
        agentSpan.setAttribute("description", agentDesc{{ loop.index }});
        agentSpan.setAttribute("gen_ai.operation.name", "invoke_agent");
        agentSpan.setAttribute("gen_ai.agent.name", AGENT_NAME);
        agentSpan.setAttribute("gen_ai.request.model", model{{ loop.index }});
        agentSpan.setAttribute("gen_ai.usage.input_tokens", inputTokens{{ loop.index }});
        agentSpan.setAttribute("gen_ai.usage.input_tokens.cached", Math.max(0, Math.floor(inputTokens{{ loop.index }} / 3)));
        agentSpan.setAttribute("gen_ai.usage.output_tokens", outputTokens{{ loop.index }});
        agentSpan.setAttribute("gen_ai.usage.output_tokens.reasoning", Math.max(0, Math.floor(outputTokens{{ loop.index }} / 4)));
        agentSpan.setAttribute("gen_ai.usage.total_tokens", totalTokens{{ loop.index }});

        // Chat span (child of agent)
        const chatDesc{{ loop.index }} = `chat ${model{{ loop.index }}}`;
        await Sentry.startSpan({ op: "gen_ai.chat", name: chatDesc{{ loop.index }} }, async (chatSpan) => {
          chatSpan.setAttribute("description", chatDesc{{ loop.index }});
          chatSpan.setAttribute("gen_ai.operation.name", "chat");
          chatSpan.setAttribute("gen_ai.agent.name", AGENT_NAME);
          chatSpan.setAttribute("gen_ai.request.model", model{{ loop.index }});
          chatSpan.setAttribute("gen_ai.response.model", model{{ loop.index }});
          chatSpan.setAttribute("gen_ai.usage.input_tokens", inputTokens{{ loop.index }});
          chatSpan.setAttribute("gen_ai.usage.input_tokens.cached", Math.max(0, Math.floor(inputTokens{{ loop.index }} / 3)));
          chatSpan.setAttribute("gen_ai.usage.output_tokens", outputTokens{{ loop.index }});
          chatSpan.setAttribute("gen_ai.usage.output_tokens.reasoning", Math.max(0, Math.floor(outputTokens{{ loop.index }} / 4)));
          chatSpan.setAttribute("gen_ai.usage.total_tokens", totalTokens{{ loop.index }});

          chatSpan.setAttribute("gen_ai.input.messages", otelJson{{ loop.index }});
          chatSpan.setAttribute("gen_ai.output.messages", outputMessages{{ loop.index }});
          if (system{{ loop.index }} !== null) {
            chatSpan.setAttribute("gen_ai.system_instructions", system{{ loop.index }});
          }

          if (toolDefinitions{{ loop.index }}.length > 0) {
            chatSpan.setAttribute("gen_ai.tool.definitions", toolDefinitionsJson{{ loop.index }});
          }
        });

        // Tool spans (children of agent)
{% set turnIndex = loop.index %}
{% for tool in agent.tools %}
{% if tool.result is defined or tool.error is defined %}
        const toolDesc{{ turnIndex }}_{{ loop.index }} = "execute_tool {{ tool.name }}";
        await Sentry.startSpan({ op: "gen_ai.execute_tool", name: toolDesc{{ turnIndex }}_{{ loop.index }} }, async (toolSpan) => {
          toolSpan.setAttribute("description", toolDesc{{ turnIndex }}_{{ loop.index }});
          toolSpan.setAttribute("gen_ai.operation.name", "execute_tool");
          toolSpan.setAttribute("gen_ai.agent.name", AGENT_NAME);
          toolSpan.setAttribute("gen_ai.tool.name", "{{ tool.name }}");
          toolSpan.setAttribute("gen_ai.tool.description", "{{ tool.description }}");

          const toolInputJson{{ turnIndex }}_{{ loop.index }} = JSON.stringify({{ tool.arguments | dump }});
          toolSpan.setAttribute("gen_ai.tool.call.arguments", toolInputJson{{ turnIndex }}_{{ loop.index }});
{% if tool.result is defined %}

          toolSpan.setAttribute("gen_ai.tool.call.result", JSON.stringify({{ tool.result | dump }}));
{% endif %}
{% if tool.error is defined %}

          toolSpan.setStatus({ code: 2, message: "internal_error" });
{% endif %}
        });

{% endif %}
{% endfor %}
      });

      console.log(`Turn {{ loop.index }} Agent result: ${responseText{{ loop.index }}}`);
{% endfor %}
{% endblock %}
