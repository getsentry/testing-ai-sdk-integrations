{% extends "base.js.njk" %}

{% block imports %}
{{ super() }}
// LangGraph is imported dynamically after Sentry.init() to ensure instrumentation hooks are in place
{% endblock %}

{% block setup %}
// Agent will be initialized after dynamic imports
let agent;
{% endblock %}

{% block test %}
// Dynamic imports AFTER Sentry.init() to ensure instrumentation
const { ChatOpenAI } = await import('@langchain/openai');
const { createReactAgent } = await import('@langchain/langgraph/prebuilt');
const { HumanMessage, SystemMessage } = await import('@langchain/core/messages');

// Initialize ChatOpenAI for LangGraph
const llm = new ChatOpenAI({
  modelName: '{{ inputs[0].model }}',
  apiKey: process.env.OPENAI_API_KEY,
});

// Create react agent with no tools
agent = createReactAgent({ llm, tools: [] });

{% for input in inputs %}
  // Turn {{ loop.index }}: Run agent
  const messages{{ loop.index }} = [
{% for message in input.messages %}
  {% if message.role == 'system' %}
    new SystemMessage('{{ message.content }}'),
  {% elif message.role == 'user' %}
    new HumanMessage('{{ message.content }}'),
  {% endif %}
{% endfor %}
  ];

  const result{{ loop.index }} = await agent.invoke({
    messages: messages{{ loop.index }},
  });

  // Extract the AI's response from the result
  const responseMessages{{ loop.index }} = result{{ loop.index }}.messages;
  const lastMessage{{ loop.index }} = responseMessages{{ loop.index }}[responseMessages{{ loop.index }}.length - 1];

  // Print response
  console.log(`Turn {{ loop.index }} Response: ${lastMessage{{ loop.index }}.content}`);
{% if not loop.last %}
  console.log();  // Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
