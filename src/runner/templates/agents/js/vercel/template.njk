{% extends "base.js.njk" %}

{% block imports %}
{{ super() }}
const { generateText } = require('ai');
const { openai } = require('@ai-sdk/openai');
{% endblock %}

{% block setup %}
// Vercel AI SDK setup - uses openai provider
{% endblock %}

{% block test %}
{% for input in inputs %}
  // Turn {{ loop.index }}: Generate text
  {# Extract system and user messages #}
  {% set system_content = "" %}
  {% set user_content = "" %}
  {% for message in input.messages %}
    {% if message.role == 'system' %}
      {% set system_content = message.content %}
    {% elif message.role == 'user' %}
      {% set user_content = message.content %}
    {% endif %}
  {% endfor %}

  const { text: text{{ loop.index }} } = await generateText({
    model: openai('{{ input.model }}'),
{% if system_content %}
    system: '{{ system_content }}',
{% endif %}
    prompt: '{{ user_content }}',
  });

  // Print response
  console.log(`Turn {{ loop.index }} Response: ${text{{ loop.index }}}`);
{% if not loop.last %}
  console.log();  // Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
