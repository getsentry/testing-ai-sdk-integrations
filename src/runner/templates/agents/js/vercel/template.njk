{% extends "base.js.njk" %}

{% block imports %}
{{ super() }}
// Vercel AI SDK is imported dynamically after Sentry.init() to ensure instrumentation hooks are in place
{% endblock %}

{% block setup %}
// SDK functions will be imported dynamically
{% endblock %}

{% block test %}
// Dynamic imports AFTER Sentry.init() to ensure instrumentation
const { generateText } = await import('ai');
const { openai } = await import('@ai-sdk/openai');

{% for input in inputs %}
  // Turn {{ loop.index }}: Generate text
  {# Extract system and user messages #}
  {% set system_content = "" %}
  {% set user_content = "" %}
  {% for message in input.messages %}
    {% if message.role == 'system' %}
      {% set system_content = message.content %}
    {% elif message.role == 'user' %}
      {% set user_content = message.content %}
    {% endif %}
  {% endfor %}

  const { text: text{{ loop.index }} } = await generateText({
    model: openai('{{ input.model }}'),
{% if system_content %}
    system: '{{ system_content }}',
{% endif %}
    prompt: '{{ user_content }}',
  });

  // Print response
  console.log(`Turn {{ loop.index }} Response: ${text{{ loop.index }}}`);
{% if not loop.last %}
  console.log();  // Blank line between turns
{% endif %}
{% endfor %}
{% endblock %}
