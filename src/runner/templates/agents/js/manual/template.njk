{% extends "base.js.njk" %}

{% block setup %}
function estimateTokens(text) {
  return Math.max(1, Math.floor(String(text).length / 4));
}

function messagesContentLength(messages) {
  let total = 0;
  for (const m of messages) {
    const c = m.content;
    if (typeof c === "string") {
      total += c.length;
    } else if (Array.isArray(c)) {
      for (const part of c) {
        if (part.text) total += part.text.length;
      }
    }
  }
  return total;
}

function trimMessages(messages, maxSize = 10000) {
  const fullJson = JSON.stringify(messages);
  const originalLength = fullJson.length;
  if (originalLength <= maxSize) {
    return { messages, originalLength, trimmed: false };
  }
  const trimmed = messages.map((msg) => {
    const copy = { ...msg };
    if (typeof copy.content === "string" && copy.content.length > 200) {
      copy.content = copy.content.slice(0, 200) + "... [trimmed]";
    }
    if (Array.isArray(copy.parts)) {
      copy.parts = copy.parts.map((p) => {
        if (typeof p.text === "string" && p.text.length > 200) {
          return { ...p, text: p.text.slice(0, 200) + "... [trimmed]" };
        }
        return p;
      });
    }
    return copy;
  });
  return { messages: trimmed, originalLength, trimmed: true };
}

function buildSentryMessages(messages) {
  const sentryMessages = [];
  const legacyMessages = [];
  let systemInstructions = null;

  for (const msg of messages) {
    const { role, content } = msg;

    if (role === "system") {
      systemInstructions = typeof content === "string" ? content : JSON.stringify(content);
    }

    const parts = [];
    if (typeof content === "string") {
      parts.push({ type: "text", text: content });
    } else if (Array.isArray(content)) {
      for (const part of content) {
        if (part.type === "text") {
          parts.push({ type: "text", text: part.text });
        } else if (part.type === "image") {
          parts.push({ type: "text", text: "[Blob substitute]" });
        }
      }
    }

    sentryMessages.push({
      role,
      content: typeof content === "string" ? content : "[multimodal]",
      parts,
    });

    if (Array.isArray(content)) {
      const redacted = content.map((part) =>
        part.type === "image" ? { type: "text", text: "[Blob substitute]" } : part
      );
      legacyMessages.push({ role, content: redacted });
    } else {
      legacyMessages.push({ role, content });
    }
  }

  return { sentryMessages, legacyMessages, systemInstructions };
}

const AGENT_NAME = "{{ agent.name }}";
const TOOLS = {{ agent.tools | dump }};
{% endblock %}

{% block test %}
{% for input in inputs %}
      // ── Turn {{ loop.index }} ──
      const model = "{{ input.model }}";
      const messages = {{ input.messages | dump }};

      const { sentryMessages, legacyMessages, systemInstructions } = buildSentryMessages(messages);

      const otel = trimMessages(sentryMessages);
      const leg = trimMessages(legacyMessages);
      const otelJson = JSON.stringify(otel.messages);
      const legacyJson = JSON.stringify(leg.messages);

      const contentLen = messagesContentLength(messages);
      const inputTokens = estimateTokens(contentLen) + 10;
      const outputTokens = 20;
      const totalTokens = inputTokens + outputTokens;
      const responseText = "This is a simulated agent response for turn {{ loop.index }}.";

      // Build available_tools and response tool_calls
      const availableTools = [];
      const toolDefinitions = [];
      const responseToolCalls = [];
      const outputToolCallParts = [];
      for (const tool of TOOLS) {
        availableTools.push({
          name: tool.name,
          description: tool.description,
          parameters: tool.parameters || {},
        });
        toolDefinitions.push({
          name: tool.name,
          description: tool.description,
          parameters: tool.parameters || {},
        });
        if (tool.result !== undefined || tool.error !== undefined) {
          const toolArgs = tool.arguments || {};
          responseToolCalls.push({
            name: tool.name,
            arguments: JSON.stringify(toolArgs),
          });
          outputToolCallParts.push({
            type: "tool_call",
            name: tool.name,
            arguments: JSON.stringify(toolArgs),
          });
        }
      }
      const availableToolsJson = JSON.stringify(availableTools);
      const toolDefinitionsJson = JSON.stringify(toolDefinitions);
      const responseToolCallsJson = responseToolCalls.length > 0 ? JSON.stringify(responseToolCalls) : null;

      const outputParts = [{ type: "text", text: responseText }, ...outputToolCallParts];
      const outputMessages = JSON.stringify([{ role: "assistant", parts: outputParts }]);

      // Agent span (parent)
      const agentDesc = `invoke_agent ${model}`;
      await Sentry.startSpan({ op: "gen_ai.invoke_agent", name: agentDesc }, async (agentSpan) => {
        agentSpan.setAttribute("span.description", agentDesc);
        agentSpan.setAttribute("gen_ai.operation.name", "invoke_agent");
        agentSpan.setAttribute("gen_ai.agent.name", AGENT_NAME);
        agentSpan.setAttribute("gen_ai.request.model", model);
        agentSpan.setAttribute("gen_ai.usage.input_tokens", inputTokens);
        agentSpan.setAttribute("gen_ai.usage.input_tokens.cached", Math.max(0, Math.floor(inputTokens / 3)));
        agentSpan.setAttribute("gen_ai.usage.output_tokens", outputTokens);
        agentSpan.setAttribute("gen_ai.usage.output_tokens.reasoning", Math.max(0, Math.floor(outputTokens / 4)));
        agentSpan.setAttribute("gen_ai.usage.total_tokens", totalTokens);

        // Chat span (child of agent)
        const chatDesc = `chat ${model}`;
        await Sentry.startSpan({ op: "gen_ai.chat", name: chatDesc }, async (chatSpan) => {
          chatSpan.setAttribute("span.description", chatDesc);
          chatSpan.setAttribute("gen_ai.operation.name", "chat");
          chatSpan.setAttribute("gen_ai.agent.name", AGENT_NAME);
          chatSpan.setAttribute("gen_ai.request.model", model);
          chatSpan.setAttribute("gen_ai.response.model", model);
          chatSpan.setAttribute("gen_ai.response.text", responseText);
          chatSpan.setAttribute("gen_ai.usage.input_tokens", inputTokens);
          chatSpan.setAttribute("gen_ai.usage.input_tokens.cached", Math.max(0, Math.floor(inputTokens / 3)));
          chatSpan.setAttribute("gen_ai.usage.output_tokens", outputTokens);
          chatSpan.setAttribute("gen_ai.usage.output_tokens.reasoning", Math.max(0, Math.floor(outputTokens / 4)));
          chatSpan.setAttribute("gen_ai.usage.total_tokens", totalTokens);

          chatSpan.setAttribute("gen_ai.request.messages", legacyJson);
          if (leg.trimmed) {
            chatSpan.setAttribute("gen_ai.request.messages.original_length", leg.originalLength);
          }

          chatSpan.setAttribute("gen_ai.input.messages", otelJson);
          if (otel.trimmed) {
            chatSpan.setAttribute("gen_ai.input.messages.original_length", otel.originalLength);
          }
          chatSpan.setAttribute("gen_ai.output.messages", outputMessages);
          if (systemInstructions !== null) {
            chatSpan.setAttribute("gen_ai.system_instructions", systemInstructions);
          }

          if (availableTools.length > 0) {
            chatSpan.setAttribute("gen_ai.request.available_tools", availableToolsJson);
            chatSpan.setAttribute("gen_ai.tool.definitions", toolDefinitionsJson);
          }
          if (responseToolCallsJson) {
            chatSpan.setAttribute("gen_ai.response.tool_calls", responseToolCallsJson);
          }
        });

        // Tool spans (children of agent)
{% for tool in agent.tools %}
{% if tool.result is defined or tool.error is defined %}
        const toolDesc{{ loop.index }} = "execute_tool {{ tool.name }}";
        await Sentry.startSpan({ op: "gen_ai.execute_tool", name: toolDesc{{ loop.index }} }, async (toolSpan) => {
          toolSpan.setAttribute("span.description", toolDesc{{ loop.index }});
          toolSpan.setAttribute("gen_ai.operation.name", "execute_tool");
          toolSpan.setAttribute("gen_ai.agent.name", AGENT_NAME);
          toolSpan.setAttribute("gen_ai.tool.name", "{{ tool.name }}");
          toolSpan.setAttribute("gen_ai.tool.type", "function");
          toolSpan.setAttribute("gen_ai.tool.description", "{{ tool.description }}");

          const toolInputJson{{ loop.index }} = JSON.stringify({{ tool.arguments | dump }});
          toolSpan.setAttribute("gen_ai.tool.input", toolInputJson{{ loop.index }});
          toolSpan.setAttribute("gen_ai.tool.call.arguments", toolInputJson{{ loop.index }});
{% if tool.result is defined %}

          toolSpan.setAttribute("gen_ai.tool.output", JSON.stringify({{ tool.result | dump }}));
          toolSpan.setAttribute("gen_ai.tool.call.result", JSON.stringify({{ tool.result | dump }}));
{% endif %}
{% if tool.error is defined %}

          toolSpan.setStatus({ code: 2, message: "internal_error" });
          toolSpan.setAttribute("gen_ai.tool.error", "{{ tool.error }}");
{% endif %}
        });

{% endif %}
{% endfor %}
      });

      console.log(`Turn {{ loop.index }} Agent result: ${responseText}`);
{% endfor %}
{% endblock %}
