{
  "name": "vercel",
  "platform": "cloudflare",
  "streamingMode": "both",
  "dependencies": [
    {
      "package": "ai",
      "version": "framework"
    },
    {
      "package": "@ai-sdk/openai",
      "version": "3.0.90"
    },
    {
      "package": "@ai-sdk/anthropic",
      "version": "3.0.105"
    }
  ],
  "versions": ["6.0.116", "7.0.79"],
  "versionOverrides": {
    "6.0.116": {
      "templateOptions": {
        "apiStyle": "v6"
      }
    },
    "7.0.79": {
      "dependencies": {
        "@ai-sdk/openai": "4.0.47",
        "@ai-sdk/anthropic": "4.0.42"
      },
      "templateOptions": {
        "apiStyle": "v7"
      }
    }
  },
  "sentryVersions": ["10"],
  "options": {
    "agentStyle": ["function", "class"],
    "provider": [
      {
        "value": "openai",
        "overrides": {
          "modelOverrides": {
            "request": "openai/gpt-4o-mini",
            "response": "openai/gpt-4o-mini*"
          }
        }
      },
      {
        "value": "anthropic",
        "overrides": {
          "modelOverrides": {
            "request": "anthropic/claude-haiku-4-5",
            "response": "anthropic/claude-haiku-4.5*"
          }
        }
      }
    ]
  }
}
