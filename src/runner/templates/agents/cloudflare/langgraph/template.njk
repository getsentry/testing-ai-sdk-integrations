{% extends "base.cloudflare.njk" %}

{# Macro to convert JSON Schema type to Zod type #}
{% macro zodType(type_str) -%}
{% if type_str == 'number' %}z.number(){% elif type_str == 'integer' %}z.number().int(){% elif type_str == 'boolean' %}z.boolean(){% else %}z.string(){% endif %}
{%- endmacro %}

{# Macro to render message content for LangChain/LangGraph - handles both string and multimodal array #}
{% macro renderLangChainContent(content) %}
{% if content is string %}
"{{ content }}"
{%- elif content is iterable %}
[
{% for part in content %}
{% if part.type == 'text' %}
          { type: "text", text: "{{ part.text }}" },
{% elif part.type == 'image' %}
          { type: "image_url", image_url: { url: "data:{{ part.mediaType }};base64,{{ part.base64 }}" } },
{% endif %}
{% endfor %}
        ]
{%- endif %}
{% endmacro %}

{% block imports %}
{% if provider == "anthropic" %}
import { ChatAnthropic } from "@langchain/anthropic";
{% else %}
import { ChatOpenAI } from "@langchain/openai";
{% endif %}
import { createReactAgent } from "@langchain/langgraph/prebuilt";
import { HumanMessage, SystemMessage } from "@langchain/core/messages";
{% if agent and agent.tools and agent.tools.length > 0 %}
import { tool } from "@langchain/core/tools";
import { z } from "zod";
{% endif %}
{% endblock %}

{% block dynamic_imports %}
{% if agent and agent.tools and agent.tools.length > 0 %}
      const tools = [
{% for toolDef in agent.tools %}
        tool(async (input) => {
{% if toolDef.error %}
          throw new Error("{{ toolDef.error }}");
{% elif toolDef.result is defined %}
          return {{ toolDef.result | dump }};
{% else %}
          return input;
{% endif %}
        }, {
          name: "{{ toolDef.name }}",
          description: "{{ toolDef.description }}",
          schema: z.object({
{% if toolDef.parameters and toolDef.parameters.properties %}
{% for paramName, paramDef in toolDef.parameters.properties %}
            {{ paramName }}: {{ zodType(paramDef.type) }}{% if paramDef.description %}.describe("{{ paramDef.description }}"){% endif %},
{% endfor %}
{% endif %}
          }),
        }),
{% endfor %}
      ];
{% endif %}

{% if provider == "anthropic" %}
      const llm = new ChatAnthropic({
        modelName: {% if causeAPIError %}"invalid-model"{% else %}"{{ inputs[0].model }}"{% endif %},
        anthropicApiKey: env.OPENROUTER_API_KEY,
        anthropicApiUrl: "https://openrouter.ai/api",
      });
{% else %}
      const llm = new ChatOpenAI({
        modelName: {% if causeAPIError %}"invalid-model"{% else %}"{{ inputs[0].model }}"{% endif %},
        openAIApiKey: env.OPENAI_API_KEY,
      });
{% endif %}
      const instrumentedCreateReactAgent = Sentry.instrumentCreateReactAgent(createReactAgent, { recordInputs: true, recordOutputs: true });
      const agent = instrumentedCreateReactAgent({ llm, tools: {% if agent and agent.tools and agent.tools.length > 0 %}tools{% else %}[]{% endif %}, name: "{{ agent.name }}" });
{% endblock %}

{% block test %}
{% for input in inputs %}
{% if input.conversationId %}
      if (typeof Sentry.setConversationId === "function") {
        Sentry.setConversationId("{{ input.conversationId }}");
      }
{% endif %}
      // Request {{ loop.index }}{% if loop.length > 1 %} of {{ loop.length }}{% endif %}

      const messages{{ loop.index }} = [
{% for message in input.messages %}
{% if message.role == 'system' %}
        new SystemMessage("{{ message.content }}"),
{% elif message.role == 'user' %}
        new HumanMessage({ content: {{ renderLangChainContent(message.content) }} }),
{% endif %}
{% endfor %}
      ];

      try {
        const result = await agent.invoke({ messages: messages{{ loop.index }} });
        const lastMessage = result.messages[result.messages.length - 1];
        console.log("Response:", lastMessage.content);
      } catch (error) {
        Sentry.captureException(error);
        console.error("Error:", error.message);
      }
{% endfor %}
{% endblock %}
