{% extends "base.python.assessment.njk" %}

{% block dynamic_imports %}
from langgraph.prebuilt import create_react_agent
{% if provider == "anthropic" %}
from langchain_anthropic import ChatAnthropic
{% else %}
from langchain_openai import ChatOpenAI
{% endif %}
from langchain_core.messages import AIMessage, HumanMessage, SystemMessage
from langchain_core.tools import StructuredTool


def assessment_langgraph_tool(definition):
    def execute(**arguments):
        return execute_assessment_tool(definition, arguments)
    return StructuredTool.from_function(
        func=execute, name=definition["name"], description=definition["description"],
        args_schema=definition["parameters"], infer_schema=False,
    )
{% endblock %}

{% block probe %}
                for request in probe["input"]["calls"]:
                    with assessment_call(probe, request):
                        if request.get("conversationId"):
                            sentry_sdk.ai.set_conversation_id(request["conversationId"])
                        messages = [
                            SystemMessage(content=message["content"]) if message["role"] == "system" else AIMessage(content=message["content"]) if message["role"] == "assistant" else HumanMessage(content=message["content"])
                            for message in request["messages"]
                        ]
    {% if provider == "anthropic" %}
                        llm = ChatAnthropic(model=request["model"], api_key=os.environ["OPENROUTER_API_KEY"], base_url="https://openrouter.ai/api")
    {% else %}
                        llm = ChatOpenAI(model=request["model"], api_key=os.environ["OPENROUTER_API_KEY"], base_url="https://openrouter.ai/api/v1")
    {% endif %}
                        try:
                            tools = [assessment_langgraph_tool(definition) for definition in probe["input"].get("tools", [])]
                            agent = create_react_agent(llm, tools=tools)
    {% if isAsync %}
                            if request.get("streaming"):
                                async for _chunk in agent.astream({"messages": messages}):
                                    pass
                            else:
                                await agent.ainvoke({"messages": messages})
    {% else %}
                            if request.get("streaming"):
                                for _chunk in agent.stream({"messages": messages}):
                                    pass
                            else:
                                agent.invoke({"messages": messages})
    {% endif %}
                        except Exception as error:
                            if probe["input"].get("expectError"):
                                capture_expected_error(error)
                                continue
                            raise
{% endblock %}
