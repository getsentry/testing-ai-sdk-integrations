{
  "name": "pydantic-ai",
  "displayName": "Pydantic AI Python SDK",
  "type": "agentic",
  "platform": "python",
  "executionMode": "async",
  "minimumPlatformVersion": "3.10",
  "dependencies": [
    {
      "package": "pydantic-ai",
      "version": "framework"
    }
  ],
  "versions": ["1.52.0"],
  "sentryVersions": ["latest"],
  "options": {
    "modelSetup": [
      "single",
      {
        "value": "fallback",
        "overrides": {
          "modelOverrides": {
            "request": "fallback:definitely-not-a-real-model,gpt5-nano"
          }
        }
      }
    ]
  }
}
