{
  "name": "pydantic-ai",
  "platform": "python",
  "executionMode": "async",
  "minimumPlatformVersion": "3.10",
  "dependencies": [
    {
      "package": "pydantic-ai",
      "version": "framework"
    }
  ],
  "versions": [">=2,<3"],
  "sentryVersions": ["latest"],
  "options": {
    "modelSetup": [
      "single",
      {
        "value": "fallback",
        "overrides": {
          "modelOverrides": {
            "request": "fallback:gpt-4o-mini-bad-model-name,gpt-5-nano",
            "response": "gpt-5-nano*"
          }
        }
      }
    ]
  }
}
