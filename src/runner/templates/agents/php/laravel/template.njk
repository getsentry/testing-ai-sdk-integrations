<?php
/**
 * Generated artisan command for {{ testName }}
 * Framework: Laravel AI ({{ frameworkName }})
 */

namespace App\Console\Commands;

use Illuminate\Console\Command;
use App\Ai\Agents\{{ agentClassName }};
use Sentry\State\Scope;
use Sentry\Tracing\TransactionContext;

class {{ commandClassName }} extends Command
{
    protected $signature = '{{ commandSignature }}';
    protected $description = 'Test: {{ testName }}';

    public function handle(): int
    {
        // Start a Sentry transaction (artisan commands don't auto-create one)
        $context = new TransactionContext();
        $context->setName('{{ commandSignature }}');
        $context->setOp('console.command');

        $transaction = \Sentry\startTransaction($context);
        \Sentry\configureScope(function (Scope $scope) use ($transaction): void {
            $scope->setSpan($transaction);
        });

        try {
{% for input in inputs %}
            // Turn {{ loop.index }}
{% set user_content = null %}
{% for message in input.messages %}
{% if message.role == 'user' %}
{% if message.content is string %}
{% set user_content = message.content %}
{% endif %}
{% endif %}
{% endfor %}
            $agent = new {{ agentClassName }}();
{% if isStreaming %}
            $stream = $agent->stream("{{ user_content }}");
            $chunks = [];
            foreach ($stream as $event) {
                $chunks[] = (string) $event;
            }
            $this->info("Turn {{ loop.index }} Response: " . implode('', $chunks));
{% else %}
            $response = $agent->prompt("{{ user_content }}");
            $this->info("Turn {{ loop.index }} Response: " . $response->text);
{% endif %}
{% if not loop.last %}
            $this->info("");
{% endif %}
{% endfor %}
        } finally {
            $transaction->finish();
        }

        // Flush Sentry data
        \Sentry\Laravel\Integration::flushEvents();

        return Command::SUCCESS;
    }
}
