/**
 * Generated test file for {{ testName }}
 * Framework: {{ frameworkName }}
{% if causeAPIError %} * Cause API Error: yes{% endif %}
 */

{% block imports %}
import * as Sentry from '@sentry/node';
{% endblock %}

{# 
  causeAPIError: When true, tests should use an invalid model name to trigger API errors.
  Templates can use this to modify model names or other parameters.
  
  Usage in child templates:
    model: {% if causeAPIError %}"invalid-model-that-does-not-exist"{% else %}"{{ input.model }}"{% endif %}
#}

{% block sdk_setup %}
Sentry.init({
  dsn: process.env.SENTRY_DSN,
  sendDefaultPii: true,
  // Tracing must be enabled for AI monitoring to work
  tracesSampleRate: 1.0,
});
{% endblock %}

{% block setup %}
// Use this to run code before the test to setup stuff
{% endblock %}

async function main() {
  // Wrap in a Sentry span to ensure AI instrumentation captures spans
  await Sentry.startSpan({ name: 'test-{{ testName | lower | replace(" ", "-") }}', op: 'test' }, async () => {
    {% block test %}
    // Implement test logic here
    console.log('Test not implemented');
    {% endblock %}
  });
}

{% block teardown %}
// Use this to run code after the test
{% endblock %}

// Execute test
main()
  .catch((error) => {
    console.error('Test failed:', error);
    process.exit(1);
  })
  .finally(async () => {
    // Ensure Sentry flushes all events
    await Sentry.flush(5000);
  });
