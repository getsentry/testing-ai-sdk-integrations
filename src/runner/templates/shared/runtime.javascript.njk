let activeAssessmentCall;
let lastCallFailure;
let toolExecutionIndex = 0;

class AssessmentToolError extends Error {}

function expectedToolError(error, depth = 0) {
  if (!error || depth >= 8) return false;
  if (error instanceof AssessmentToolError) return true;
  if (Array.isArray(error.errors) && error.errors.length) return error.errors.every(item => expectedToolError(item, depth + 1));
  return expectedToolError(error.cause, depth + 1);
}

async function consumeAssessmentStream(stream) {
  for await (const chunk of stream) {
    if (chunk.type === "error") throw chunk.error ?? chunk.payload?.error ?? new Error("Agent stream emitted an error without details.");
  }
}

function describeFailure(error, probeId, callId) {
  let current = error;
  let statusCode;
  let code;
  let retryAfter;
  for (let depth = 0; current && depth < 8; depth++) {
    const status = current.statusCode ?? current.status ?? current.response?.status;
    if (Number.isInteger(status) && status >= 100 && status <= 599) statusCode ??= status;
    if (typeof current.code === "string") code ??= current.code;
    const headers = current.responseHeaders ?? current.headers ?? current.response?.headers;
    retryAfter ??= headers?.get?.("retry-after") ?? headers?.["retry-after"];
    current = current.cause ?? current.errors?.at?.(-1);
  }
  const failure = {
    kind: statusCode !== undefined || /^(ECONNRESET|ECONNREFUSED|ETIMEDOUT|EPIPE|UND_ERR_SOCKET|UND_ERR_CONNECT_TIMEOUT)$/.test(code ?? "") ? "provider" : "harness",
    message: error instanceof Error ? error.message : String(error),
    probeId,
    callId,
    stopsVariant: true,
    statusCode,
    code,
  };
  if (retryAfter !== undefined) {
    const seconds = Number(retryAfter);
    const delay = Number.isFinite(seconds) ? seconds * 1000 : Date.parse(retryAfter) - Date.now();
    if (Number.isFinite(delay)) failure.retryAfterMs = Math.max(0, delay);
  }
  return failure;
}

function isExpectedProviderError(failure) {
  const detail = `${failure.code ?? ""} ${failure.message}`;
  return [400, 404, 422].includes(failure.statusCode)
    && !/API[_ -]?KEY|UNAUTHENTICATED|authentication|authorization|credential|quota|rate.?limit|billing/i.test(detail)
    && /sentry-assessment-invalid-model|invalid[ _-]?model|model[ _-]?not[ _-]?found|not.*valid.*model|model.*(?:not found|not exist|invalid|unsupported)|unknown.*model/i.test(detail);
}

function recordExpectedError(error) {
  const call = activeAssessmentCall;
  const failure = describeFailure(error, call?.probeId, call?.callId);
  if (!isExpectedProviderError(failure)) throw error;
  if (!call) throw new Error("Expected provider error outside an assessment call.");
  call.failure = failure;
  call.expectedError = true;
}

function captureExpectedError(error) {
  recordExpectedError(error);
  return Sentry.captureException(error);
}

async function runAssessmentCall(probe, request, callback) {
  if (typeof request.assessmentCallId !== "string" || typeof request.assessmentCallMode !== "string") {
    throw new Error(`Assessment call metadata is missing for ${probe.id}.`);
  }
  const call = { probeId: probe.id, callId: request.assessmentCallId, mode: request.assessmentCallMode };
  activeAssessmentCall = call;
  lastCallFailure = undefined;
  emit({ type: "call_started", ...call });
  try {
    const result = await Sentry.startSpan({
      name: call.callId,
      op: "test.assessment.call",
      attributes: { "test.probe.id": probe.id, "test.call.id": call.callId, "test.call.mode": call.mode },
    }, callback);
    emit({ type: "call_finished", ...call, status: call.failure ? "failed" : "succeeded" });
    return result;
  } catch (error) {
    const failure = describeFailure(error, probe.id, call.callId);
    const expectedError = failure.kind === "harness" && expectedToolError(error);
    lastCallFailure = expectedError ? undefined : failure;
    emit({ type: "call_finished", ...call, expectedError, status: "failed", failure });
    if (!expectedError) throw error;
  } finally {
    activeAssessmentCall = undefined;
  }
}

async function runAssessmentTool(definition, args, callback, toolCallId) {
  const call = activeAssessmentCall;
  if (!call) throw new Error("Tool execution outside an assessment call.");
  const tool = { probeId: call.probeId, callId: call.callId, id: `${call.callId}:tool:${toolExecutionIndex++}`, name: definition.name, toolCallId };
  emit({ type: "tool_started", ...tool, arguments: args });
  try {
    const result = await callback();
    emit({ type: "tool_finished", ...tool, status: "succeeded", result });
    return result;
  } catch (error) {
    emit({ type: "tool_finished", ...tool, status: "failed", error: error instanceof Error ? error.message : String(error) });
    throw error;
  }
}
