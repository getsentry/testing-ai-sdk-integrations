import re

ACTIVE_ASSESSMENT_CALL = None
LAST_CALL_FAILURE = None
TOOL_EXECUTION_INDEX = 0


class AssessmentToolError(RuntimeError):
    pass


def expected_tool_error(error, depth=0):
    if depth >= 8 or error is None:
        return False
    if isinstance(error, AssessmentToolError):
        return True
    nested = getattr(error, "exceptions", None)
    if nested:
        return all(expected_tool_error(item, depth + 1) for item in nested)
    return expected_tool_error(getattr(error, "__cause__", None), depth + 1)


def execute_assessment_tool(definition, arguments):
    with assessment_tool(definition, arguments) as outcome:
        if definition.get("error"):
            raise AssessmentToolError(definition["error"])
        outcome["result"] = definition.get("result")
        return outcome["result"]


def describe_failure(error, probe_id=None, call_id=None):
    current = error
    status = None
    code = None
    retry_after = None
    for _depth in range(8):
        if current is None:
            break
        response = getattr(current, "response", None)
        candidate = getattr(current, "status_code", None) or getattr(current, "code", None) or getattr(response, "status_code", None)
        if isinstance(candidate, int) and 100 <= candidate <= 599:
            status = status or candidate
        candidate_code = getattr(current, "code", None)
        if isinstance(candidate_code, str):
            code = code or candidate_code
        if isinstance(current, ConnectionResetError):
            code = "ECONNRESET"
        elif isinstance(current, ConnectionRefusedError):
            code = "ECONNREFUSED"
        elif isinstance(current, BrokenPipeError):
            code = "EPIPE"
        elif isinstance(current, TimeoutError):
            code = "ETIMEDOUT"
        headers = getattr(response, "headers", None)
        if headers is not None:
            retry_after = retry_after or headers.get("retry-after")
        current = getattr(current, "__cause__", None) or getattr(current, "__context__", None)
    failure = {
        "kind": "provider" if status is not None or code in ("ECONNRESET", "ECONNREFUSED", "ETIMEDOUT", "EPIPE") else "harness",
        "message": str(error),
        "probeId": probe_id,
        "callId": call_id,
        "stopsVariant": True,
    }
    if status is not None:
        failure["statusCode"] = status
    if code is not None:
        failure["code"] = code
    if retry_after is not None:
        try:
            delay = float(retry_after) * 1000
        except (ValueError, TypeError):
            try:
                delay = (parsedate_to_datetime(retry_after).timestamp() - datetime.now(timezone.utc).timestamp()) * 1000
            except (ValueError, TypeError, OverflowError):
                delay = None
        if delay is not None and math.isfinite(delay):
            failure["retryAfterMs"] = max(0, delay)
    return failure


def is_expected_provider_error(failure):
    detail = f"{failure.get('code', '')} {failure['message']}"
    return (
        failure.get("statusCode") in (400, 404, 422)
        and not re.search(r"API[_ -]?KEY|UNAUTHENTICATED|authentication|authorization|credential|quota|rate.?limit|billing", detail, re.I)
        and re.search(r"sentry-assessment-invalid-model|invalid[ _-]?model|model[ _-]?not[ _-]?found|not.*valid.*model|model.*(?:not found|not exist|invalid|unsupported)|unknown.*model", detail, re.I) is not None
    )


def record_expected_error(error):
    call = ACTIVE_ASSESSMENT_CALL
    if call is None:
        raise RuntimeError("Expected provider error outside an assessment call")
    failure = describe_failure(error, call["probeId"], call["callId"])
    if not is_expected_provider_error(failure):
        raise error
    call["failure"] = failure
    call["expectedError"] = True


def capture_expected_error(error):
    record_expected_error(error)
    return sentry_sdk.capture_exception(error)


@contextmanager
def assessment_call(probe, request):
    global ACTIVE_ASSESSMENT_CALL, LAST_CALL_FAILURE
    call_id = request.get("assessmentCallId")
    mode = request.get("assessmentCallMode")
    if not isinstance(call_id, str) or not isinstance(mode, str):
        raise RuntimeError(f"Assessment call metadata is missing for {probe['id']}")
    call = {"probeId": probe["id"], "callId": call_id, "mode": mode}
    ACTIVE_ASSESSMENT_CALL = call
    LAST_CALL_FAILURE = None
    emit({"type": "call_started", **call})
    try:
        with sentry_sdk.start_span(op="test.assessment.call", name=call_id) as span:
            span.set_data("test.probe.id", probe["id"])
            span.set_data("test.call.id", call_id)
            span.set_data("test.call.mode", mode)
            yield
        emit({"type": "call_finished", **call, "status": "failed" if "failure" in call else "succeeded"})
    except Exception as error:
        failure = describe_failure(error, probe["id"], call_id)
        expected = failure["kind"] == "harness" and expected_tool_error(error)
        LAST_CALL_FAILURE = None if expected else failure
        emit({"type": "call_finished", **call, "status": "failed", "expectedError": expected, "failure": failure})
        if not expected:
            raise
    finally:
        ACTIVE_ASSESSMENT_CALL = None


@contextmanager
def assessment_tool(definition, arguments):
    global TOOL_EXECUTION_INDEX
    call = ACTIVE_ASSESSMENT_CALL
    if call is None:
        raise RuntimeError("Tool execution outside an assessment call")
    tool = {"probeId": call["probeId"], "callId": call["callId"], "id": f"{call['callId']}:tool:{TOOL_EXECUTION_INDEX}", "name": definition["name"]}
    TOOL_EXECUTION_INDEX += 1
    emit({"type": "tool_started", **tool, "arguments": arguments})
    outcome = {}
    try:
        yield outcome
    except Exception as error:
        outcome["error"] = str(error)
        raise
    finally:
        emit({"type": "tool_finished", **tool, **outcome, "status": "failed" if "error" in outcome else "succeeded"})
