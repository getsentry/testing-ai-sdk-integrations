{% extends "base.php.njk" %}

{% block imports %}
use Laravel\Ai\Embeddings;
{% endblock %}

{% block test %}
{% for input in inputs %}
            $response = Embeddings::for([{{ input.input | dump }}])->generate();
            $this->info("Embedding dimension: " . count($response->embeddings[0]));
{% endfor %}
{% endblock %}
