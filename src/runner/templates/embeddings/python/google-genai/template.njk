{% extends "base.python.njk" %}

{% block imports %}
{{ super() }}
from google import genai
{% endblock %}

{% block setup %}
client = genai.Client(
    api_key=os.environ["GOOGLE_GENAI_API_KEY"],
)
{% endblock %}

{% block test %}
{% for input in inputs %}
    {% if isAsync %}
    result = await client.aio.models.embed_content(
    {% else %}
    result = client.models.embed_content(
    {% endif %}
        model="{{ input.model }}",
        contents={{ input.input | dump }},
    )
    print(f"Embedding values: {len(result.embeddings[0].values)}")
{% endfor %}
{% endblock %}
