{% extends "base.python.njk" %}

{% block test %}
{% for input in inputs %}
    with sentry_sdk.start_span(op="gen_ai.embeddings", description="embeddings {{ input.model }}") as span:
        span.set_data("gen_ai.operation.name", "embeddings")
        span.set_data("gen_ai.request.model", "{{ input.model }}")
        span.set_data("gen_ai.response.model", "{{ input.model }}")
        span.set_data("gen_ai.embeddings.input", {{ input.input | dump }})
        span.set_data("gen_ai.usage.input_tokens", 7)
        span.set_data("gen_ai.usage.total_tokens", 7)
        print("Embedding span created for model: {{ input.model }}")
{% endfor %}
{% endblock %}
