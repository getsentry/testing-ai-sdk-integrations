{% extends "base.python.njk" %}

{% block imports %}
{{ super() }}
from langchain_openai import OpenAIEmbeddings
{% endblock %}

{% block setup %}
embeddings = OpenAIEmbeddings(model="{{ inputs[0].model }}")
{% endblock %}

{% block test %}
{% for input in inputs %}
    {% if isAsync %}
    result = await embeddings.aembed_query({{ input.input | dump }})
    {% else %}
    result = embeddings.embed_query({{ input.input | dump }})
    {% endif %}
    print(f"Embedding dimension: {len(result)}")
{% endfor %}
{% endblock %}
