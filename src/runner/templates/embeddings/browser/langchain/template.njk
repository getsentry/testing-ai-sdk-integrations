{% extends "base.browser.njk" %}

{% block dynamic_imports %}
    const { OpenAIEmbeddings } = await import("@langchain/openai");

    const OPENAI_API_KEY = window.OPENAI_API_KEY;
    if (!OPENAI_API_KEY) {
      log('ERROR: OPENAI_API_KEY not found in window');
      throw new Error('OPENAI_API_KEY not provided');
    }

    const embeddings = Sentry.instrumentLangChainEmbeddings(new OpenAIEmbeddings({
      modelName: "{{ inputs[0].model }}",
      openAIApiKey: OPENAI_API_KEY,
    }));

    log('LangChain OpenAIEmbeddings initialized');
{% endblock %}

{% block test %}
{% for input in inputs %}
          log('Starting embedding request {{ loop.index }}...');

          try {
            const result = await embeddings.embedQuery({{ input.input | dump }});
            log('Embedding dimension:', result.length);
          } catch (error) {
            Sentry.captureException(error);
            log('Error in request {{ loop.index }}:', error.message);
            console.error("Error:", error);
          }
{% endfor %}
{% endblock %}
