{
  "name": "google-genai",
  "displayName": "Google GenAI Browser SDK (Embeddings)",
  "type": "embeddings",
  "platform": "browser",
  "streamingMode": "blocking",
  "dependencies": [
    { "package": "@google/genai", "version": "framework" },
    { "package": "@sentry/browser", "version": "sentry" }
  ],
  "versions": ["1.38.0"],
  "sentryVersions": ["latest"],
  "modelOverrides": {
    "request": "models/gemini-embedding-001",
    "response": "models/gemini-embedding-001*"
  },
  "skip": {
    "checks": {
      "Basic Embeddings Test": ["checkEmbeddingTokenUsage"]
    }
  }
}
