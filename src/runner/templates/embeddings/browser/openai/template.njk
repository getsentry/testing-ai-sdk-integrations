{% extends "base.browser.njk" %}

{% block setup %}
    let client;
{% endblock %}

{% block dynamic_imports %}
          const OpenAI = (await import('openai')).default;

          const OPENAI_API_KEY = window.OPENAI_API_KEY;
          if (!OPENAI_API_KEY) {
            log('ERROR: OPENAI_API_KEY not found in window');
            throw new Error('OPENAI_API_KEY not provided');
          }

          const openai = new OpenAI({
            apiKey: OPENAI_API_KEY,
            dangerouslyAllowBrowser: true
          });

          client = Sentry.instrumentOpenAiClient(openai);

          log('OpenAI client initialized and instrumented');
{% endblock %}

{% block test %}
{% for input in inputs %}
          log('Starting embedding request {{ loop.index }}...');

          try {
            const response = await client.embeddings.create({
              model: "{{ input.model }}",
              input: {{ input.input | dump }},
            });
            log('Embedding dimension:', response.data[0].embedding.length);
          } catch (error) {
            Sentry.captureException(error);
            log('Error in request {{ loop.index }}:', error.message);
            console.error("Error:", error);
          }
{% endfor %}
{% endblock %}
