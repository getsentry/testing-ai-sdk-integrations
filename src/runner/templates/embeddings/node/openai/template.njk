{% extends "base.node.njk" %}

{% block setup %}
let client;
{% endblock %}

{% block dynamic_imports %}
      const OpenAI = (await import("openai")).default;
      client = new OpenAI();
{% endblock %}

{% block test %}
{% for input in inputs %}
      const response = await client.embeddings.create({
        model: "{{ input.model }}",
        input: {{ input.input | dump }},
      });
      console.log("Embedding dimension:", response.data[0].embedding.length);
{% endfor %}
{% endblock %}
