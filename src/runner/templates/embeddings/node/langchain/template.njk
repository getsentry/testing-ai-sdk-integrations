{% extends "base.node.njk" %}

{% block setup %}
let OpenAIEmbeddings;
let embeddings;
{% endblock %}

{% block dynamic_imports %}
      const langchainOpenAI = await import("@langchain/openai");
      OpenAIEmbeddings = langchainOpenAI.OpenAIEmbeddings;
      embeddings = new OpenAIEmbeddings({
        modelName: "{{ inputs[0].model }}",
      });
{% endblock %}

{% block test %}
{% for input in inputs %}
      const result = await embeddings.embedQuery({{ input.input | dump }});
      console.log("Embedding dimension:", result.length);
{% endfor %}
{% endblock %}
