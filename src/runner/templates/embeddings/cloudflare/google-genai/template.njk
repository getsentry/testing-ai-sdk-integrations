{% extends "base.cloudflare.njk" %}

{% block dynamic_imports %}
      const { GoogleGenAI } = await import("@google/genai");
      const client = new GoogleGenAI({
        apiKey: env.GOOGLE_GENAI_API_KEY,
      });
      Sentry.instrumentGoogleGenAIClient(client);
{% endblock %}

{% block test %}
{% for input in inputs %}
      const result = await client.models.embedContent({
        model: "{{ input.model }}",
        contents: {{ input.input | dump }},
      });
      console.log("Embedding values:", result.embeddings[0].values.length);
{% endfor %}
{% endblock %}
