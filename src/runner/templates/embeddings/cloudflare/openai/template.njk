{% extends "base.cloudflare.njk" %}

{% block imports %}
import OpenAI from "openai";
{% endblock %}

{% block dynamic_imports %}
      const rawClient = new OpenAI({ apiKey: env.OPENAI_API_KEY });
      const client = Sentry.instrumentOpenAiClient(rawClient);
{% endblock %}

{% block test %}
{% for input in inputs %}
      const response = await client.embeddings.create({
        model: "{{ input.model }}",
        input: {{ input.input | dump }},
      });
      console.log("Embedding dimension:", response.data[0].embedding.length);
{% endfor %}
{% endblock %}
