{% extends "base.nextjs.njk" %}

{% block setup %}
let embeddings;
{% endblock %}

{% block dynamic_imports %}
      const langchainOpenAI = await import("@langchain/openai");

      const OPENAI_API_KEY = process.env.OPENAI_API_KEY;
      if (!OPENAI_API_KEY) {
        console.error('ERROR: OPENAI_API_KEY not found in environment');
        throw new Error('OPENAI_API_KEY not provided');
      }

      embeddings = new langchainOpenAI.OpenAIEmbeddings({
        modelName: "{{ inputs[0].model }}",
        openAIApiKey: OPENAI_API_KEY,
      });

      console.log('LangChain OpenAIEmbeddings initialized');
{% endblock %}

{% block test %}
{% for input in inputs %}
      console.log('Starting embedding request {{ loop.index }}...');

      try {
        const result = await embeddings.embedQuery({{ input.input | dump }});
        console.log('Embedding dimension:', result.length);
      } catch (error) {
        Sentry.captureException(error);
        console.error('Error in request {{ loop.index }}:', error.message);
      }
{% endfor %}
{% endblock %}
