{% extends "base.nextjs.njk" %}

{% block dynamic_imports %}
const { default: OpenAI } = await import('openai');

const OPENAI_API_KEY = process.env.OPENAI_API_KEY;
if (!OPENAI_API_KEY) {
  console.error('ERROR: OPENAI_API_KEY not found in environment');
  throw new Error('OPENAI_API_KEY not provided');
}

const openai = new OpenAI({ apiKey: OPENAI_API_KEY });
const client = Sentry.instrumentOpenAiClient(openai);
console.log('OpenAI client initialized and instrumented');
{% endblock %}

{% block test %}
{% for input in inputs %}
      console.log('Starting embedding request {{ loop.index }}...');

      try {
        const response = await client.embeddings.create({
          model: "{{ input.model }}",
          input: {{ input.input | dump }},
        });
        console.log('Embedding dimension:', response.data[0].embedding.length);
      } catch (error) {
        Sentry.captureException(error);
        console.error('Error in request {{ loop.index }}:', error.message);
      }
{% endfor %}
{% endblock %}
