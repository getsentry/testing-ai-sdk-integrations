{% extends "base.python.njk" %}

{# Macro to convert parameter type to Python type annotation #}
{% macro pytype(type_str) -%}
{% if type_str == 'number' %}float{% elif type_str == 'integer' %}int{% elif type_str == 'boolean' %}bool{% else %}str{% endif %}
{%- endmacro %}

{# Macro to render function parameters from MCP parameter definitions #}
{% macro render_params(params) -%}
{% for name, def in params %}{{ name }}: {{ pytype(def.type) }}{% if not loop.last %}, {% endif %}{% endfor %}
{%- endmacro %}

{% block imports %}
{{ super() }}
{% if isSse %}
import socket
import threading
{% endif %}
import json
import anyio
from sentry_sdk.integrations.mcp import MCPIntegration
from mcp.client.session import ClientSession
{% if apiStyle == 'highlevel' %}
from mcp.server.fastmcp import FastMCP
{% if isSse %}
from mcp.client.sse import sse_client
{% endif %}
{% else %}
from mcp.server.lowlevel import Server
from mcp.types import (
    Tool,
    TextContent,
    Resource,
    ResourceTemplate,
    Prompt,
    PromptMessage,
    GetPromptResult,
    PromptArgument,
)
{% if isSse %}
from mcp.client.sse import sse_client
{% endif %}
{% endif %}
{% endblock %}

{% block sdk_setup %}
sentry_sdk.init(
    dsn=os.environ.get("SENTRY_DSN"),
    traces_sample_rate=1.0,
    send_default_pii=True,
    stream_gen_ai_spans={{ "True" if streamGenAiSpans else "False" }},
    integrations=[MCPIntegration()],
)
{% endblock %}

{% block setup %}
{% if apiStyle == 'highlevel' %}
{# ============================================ #}
{# HIGH-LEVEL API: decorator-based (FastMCP)    #}
{# ============================================ #}
mcp_server = FastMCP("{{ mcpServer.name }}")

{% if mcpServer.tools %}
# Define MCP tools
{% for tool in mcpServer.tools %}
@mcp_server.tool()
def {{ tool.name }}({{ render_params(tool.parameters) }}) -> str:
    """{{ tool.description }}"""
{% if tool.error %}
    raise Exception("{{ tool.error }}")
{% else %}
    return {{ tool.result | tojson }}
{% endif %}

{% endfor %}
{% endif %}
{% if mcpServer.resources %}
# Define MCP resources
{% for resource in mcpServer.resources %}
@mcp_server.resource("{{ resource.uri }}")
def {{ resource.name | replace("://", "_") | replace("/", "_") }}() -> str:
    """{{ resource.description or resource.name }}"""
    return {{ resource.content | tojson }}

{% endfor %}
{% endif %}
{% if mcpServer.prompts %}
# Define MCP prompts
{% for prompt in mcpServer.prompts %}
@mcp_server.prompt()
def {{ prompt.name }}({% if prompt.parameters %}{{ render_params(prompt.parameters) }}{% endif %}) -> str:
    """{{ prompt.description }}"""
    return {{ prompt.template | tojson }}

{% endfor %}
{% endif %}
{% else %}
{# ============================================ #}
{# LOW-LEVEL API: manual handler registration   #}
{# ============================================ #}
mcp_server = Server("{{ mcpServer.name }}")

{% if mcpServer.tools %}
@mcp_server.list_tools()
async def list_tools():
    return [
{% for tool in mcpServer.tools %}
        Tool(
            name="{{ tool.name }}",
            description="{{ tool.description }}",
            inputSchema={
                "type": "object",
                "properties": {
{% for pname, pdef in tool.parameters %}
                    "{{ pname }}": {"type": "{{ pdef.type }}"{% if pdef.description %}, "description": "{{ pdef.description }}"{% endif %}},
{% endfor %}
                },
                "required": [{% for pname, pdef in tool.parameters %}"{{ pname }}"{% if not loop.last %}, {% endif %}{% endfor %}],
            },
        ),
{% endfor %}
    ]


@mcp_server.call_tool()
async def call_tool(name, arguments):
{% for tool in mcpServer.tools %}
{% if loop.first %}    if{% else %}    elif{% endif %} name == "{{ tool.name }}":
{% if tool.error %}
        raise Exception("{{ tool.error }}")
{% else %}
        return [TextContent(type="text", text=json.dumps({{ tool.result | tojson }}))]
{% endif %}
{% endfor %}
    else:
        raise ValueError(f"Unknown tool: {name}")


{% endif %}
{% if mcpServer.resources %}
@mcp_server.list_resources()
async def list_resources():
    return [
{% for resource in mcpServer.resources %}
        Resource(
            uri="{{ resource.uri }}",
            name="{{ resource.name }}",
{% if resource.description %}
            description="{{ resource.description }}",
{% endif %}
        ),
{% endfor %}
    ]


@mcp_server.read_resource()
async def read_resource(uri):
    uri_str = str(uri)
{% for resource in mcpServer.resources %}
{% if loop.first %}    if{% else %}    elif{% endif %} uri_str == "{{ resource.uri }}":
        return {{ resource.content | tojson }}
{% endfor %}
    else:
        raise ValueError(f"Unknown resource: {uri_str}")


{% endif %}
{% if mcpServer.prompts %}
@mcp_server.list_prompts()
async def list_prompts():
    return [
{% for prompt in mcpServer.prompts %}
        Prompt(
            name="{{ prompt.name }}",
            description="{{ prompt.description }}",
{% if prompt.parameters %}
            arguments=[
{% for pname, pdef in prompt.parameters %}
                PromptArgument(name="{{ pname }}", description="{{ pdef.description or '' }}", required=True),
{% endfor %}
            ],
{% endif %}
        ),
{% endfor %}
    ]


@mcp_server.get_prompt()
async def get_prompt(name, arguments):
{% for prompt in mcpServer.prompts %}
{% if loop.first %}    if{% else %}    elif{% endif %} name == "{{ prompt.name }}":
        return GetPromptResult(
            messages=[
                PromptMessage(role="user", content=TextContent(type="text", text={{ prompt.template | tojson }}))
            ]
        )
{% endfor %}
    else:
        raise ValueError(f"Unknown prompt: {name}")


{% endif %}
{% endif %}
{% if isSse %}
def _wait_for_port(port, host="127.0.0.1", timeout=10):
    """Poll until the server is accepting connections on the given port."""
    import time as _time
    deadline = _time.monotonic() + timeout
    while _time.monotonic() < deadline:
        try:
            with socket.create_connection((host, port), timeout=0.5):
                return
        except OSError:
            _time.sleep(0.1)
    raise RuntimeError(f"Server on {host}:{port} did not start within {timeout}s")

SSE_PORT = int(os.environ.get("MCP_SSE_PORT", "8765"))

{% if apiStyle == 'highlevel' %}
def run_sse_server():
    """Run the MCP server with SSE transport in a background thread."""
    mcp_server.settings.host = "127.0.0.1"
    mcp_server.settings.port = SSE_PORT
    mcp_server.run(transport="sse")
{% else %}
def run_sse_server():
    """Run the low-level MCP server with SSE transport in a background thread."""
    from mcp.server.sse import SseServerTransport
    from starlette.applications import Starlette
    from starlette.routing import Route, Mount
    import uvicorn

    sse = SseServerTransport("/messages/")

    async def handle_sse(request):
        async with sse.connect_sse(request.scope, request.receive, request._send) as streams:
            await mcp_server.run(
                streams[0], streams[1], mcp_server.create_initialization_options()
            )

    app = Starlette(routes=[
        Route("/sse", endpoint=handle_sse),
        Mount("/messages/", app=sse.handle_post_message),
    ])
    uvicorn.run(app, host="127.0.0.1", port=SSE_PORT)
{% endif %}
{% endif %}
{% endblock %}

{% block test %}
{% if isSse %}
    # Start MCP server with SSE transport in background thread
    server_thread = threading.Thread(target=run_sse_server, daemon=True)
    server_thread.start()
    _wait_for_port(SSE_PORT)

    async with sse_client(f"http://127.0.0.1:{SSE_PORT}/sse") as (read_stream, write_stream):
        async with ClientSession(read_stream, write_stream) as session:
            await session.initialize()
{% else %}
    # Use in-memory streams for in-process client-server communication
{% if apiStyle == 'highlevel' %}
    server = mcp_server._mcp_server
{% else %}
    server = mcp_server
{% endif %}
    c2s_send, c2s_recv = anyio.create_memory_object_stream(0)
    s2c_send, s2c_recv = anyio.create_memory_object_stream(0)

    async with anyio.create_task_group() as tg:
        tg.start_soon(
            server.run,
            c2s_recv,
            s2c_send,
            server.create_initialization_options(),
        )
        async with ClientSession(s2c_recv, c2s_send) as session:
            await session.initialize()
{% endif %}
{% for input in inputs %}
{% if input.action == 'call_tool' %}
            try:
                result = await session.call_tool("{{ input.tool }}", {{ input.arguments | dump }})
                print(f"Tool result: {result}")
            except Exception as e:
                print(f"Tool error (expected): {type(e).__name__}: {e}")
{% elif input.action == 'read_resource' %}
            result = await session.read_resource("{{ input.uri }}")
            print(f"Resource: {result}")
{% elif input.action == 'get_prompt' %}
            result = await session.get_prompt("{{ input.prompt }}", {{ input.arguments | dump }})
            print(f"Prompt: {result}")
{% endif %}
{% endfor %}
{% if isSse %}
    # Give the server thread time to finish processing and create spans
    await asyncio.sleep(0.5)
{% else %}
        tg.cancel_scope.cancel()
{% endif %}
{% endblock %}
