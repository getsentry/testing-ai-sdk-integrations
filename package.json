{
  "name": "sentry-ai-sdks-test",
  "version": "1.0.0",
  "description": "Assessment framework for Sentry's AI SDK integrations",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "postbuild": "rm -rf dist/runner/templates && mkdir -p dist/runner/templates && cp -r src/runner/templates/* dist/runner/templates/",
    "test": "node dist/assessment-cli.js",
    "test:unit": "node --test dist/**/*.test.js",
    "assess": "node dist/assessment-cli.js",
    "setup": "node dist/assessment-cli.js render",
    "postsetup": "git submodule update --init sentry-conventions",
    "dev": "npm run build && node dist/assessment-cli.js",
    "report": "node dist/generate-assessment-html.js",
    "update-conventions": "git submodule update --remote sentry-conventions"
  },
  "keywords": [
    "sentry",
    "ai",
    "testing"
  ],
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "dotenv": "^17.2.3",
    "hono": "^4.11.8",
    "nunjucks": "^3.2.4",
    "simple-icons": "^15.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "volta": {
    "node": "22.22.0"
  }
}
